@@ -0,0 +1,111 @@
+-- Row level security of the cache audit alerts (0014_cache_audit.sql). Run AFTER 0001, 0002, 0008, 0011, 0012, 0013 and
+-- 0014. One transaction, rolled back; a failed assertion stops the script naming the check; a clean run ends with
+-- "AUDIT RLS OK".
+--
+--   owner O and member M share workspace W; outsider X owns workspace XW. Each workspace has a project, a run and one
+--   wrong-skip alert.
+
+begin;
+
+insert into auth.users (id, email, raw_user_meta_data, email_confirmed_at) values
+  ('3aaaaaaa-0000-4000-8000-000000000001', 'audit.owner@fenvix.invalid', '{"full_name":"Audit Owner"}', now()),
+  ('3bbbbbbb-0000-4000-8000-000000000002', 'audit.member@fenvix.invalid', '{"full_name":"Audit Member"}', now()),
+  ('3ddddddd-0000-4000-8000-000000000004', 'audit.outsider@fenvix.invalid', '{"full_name":"Audit Outsider"}', now());
+
+create temporary table au_ids on commit drop as
+select
+  (select workspace_id from public.workspace_members where user_id = '3aaaaaaa-0000-4000-8000-000000000001') as w,
+  (select workspace_id from public.workspace_members where user_id = '3ddddddd-0000-4000-8000-000000000004') as xw,
+  null::uuid as p, null::uuid as run;
+grant select on au_ids to authenticated, anon, fenvix_github_app;
+
+do $$
+declare r au_ids%rowtype; v_p uuid; v_xp uuid; v_run uuid; v_xrun uuid;
+begin
+  select * into r from au_ids;
+  delete from public.workspaces where id = (select workspace_id from public.workspace_members where user_id = '3bbbbbbb-0000-4000-8000-000000000002');
+  insert into public.workspace_members (workspace_id, user_id, role) values (r.w, '3bbbbbbb-0000-4000-8000-000000000002', 'member');
+  insert into public.ci_projects (workspace_id, full_name, language, test_runner, installation_id) values (r.w, 'northwind/audit', 'python', 'pytest', 71) returning id into v_p;
+  insert into public.ci_projects (workspace_id, full_name, language, test_runner, installation_id) values (r.xw, 'outsider/audit', 'python', 'pytest', 72) returning id into v_xp;
+  insert into public.ci_runs (project_id, number, commit_sha, branch, trigger, status, pushed_at, started_at, tests_total, tests_ran, tests_skipped, audit_checked, audit_matched, audit_wrong)
+    values (v_p, 1, repeat('a', 40), 'main', 'push', 'passed', now(), now(), 10, 4, 6, 3, 2, 1) returning id into v_run;
+  insert into public.ci_runs (project_id, number, commit_sha, branch, trigger, status, pushed_at, started_at)
+    values (v_xp, 1, repeat('b', 40), 'main', 'push', 'passed', now(), now()) returning id into v_xrun;
+  update au_ids set p = v_p, run = v_run;
+  insert into public.ci_audit_alerts (workspace_id, project_id, run_id, github_job_id, test_id, cached_outcome, fresh_outcome) values
+    (r.w, v_p, v_run, 7001, 'tests/test_a.py::test_x', 'passed', 'failed'),
+    (r.xw, v_xp, v_xrun, 7002, 'tests/test_b.py::test_y', 'skipped', 'passed');
+  -- the counts must add up, and audited tests ran
+  begin
+    insert into public.ci_runs (project_id, number, commit_sha, branch, trigger, status, pushed_at, started_at, tests_total, tests_ran, tests_skipped, audit_checked, audit_matched)
+      values (v_p, 2, repeat('c', 40), 'main', 'push', 'passed', now(), now(), 10, 4, 6, 3, 2);
+    assert false, 'an audit that does not add up was stored';
+  exception when check_violation then null; end;
+  begin
+    insert into public.ci_runs (project_id, number, commit_sha, branch, trigger, status, pushed_at, started_at, tests_total, tests_ran, tests_skipped, audit_checked, audit_matched)
+      values (v_p, 3, repeat('d', 40), 'main', 'push', 'passed', now(), now(), 10, 2, 8, 3, 3);
+    assert false, 'more audited tests than tests that ran were stored';
+  exception when check_violation then null; end;
+end $$;
+
+-- ---------------------------------------------------------------- anonymous: nothing
+set local role anon;
+do $$
+declare n int;
+begin
+  begin
+    select count(*) into n from public.ci_audit_alerts;
+    assert false, 'anon can read ci_audit_alerts';
+  exception when insufficient_privilege then null; end;
+end $$;
+reset role;
+
+-- ---------------------------------------------------------------- the member: reads W's alert only, writes nothing
+set local role authenticated;
+set local request.jwt.claims = '{"sub":"3bbbbbbb-0000-4000-8000-000000000002","role":"authenticated"}';
+do $$
+declare r au_ids%rowtype;
+begin
+  select * into r from au_ids;
+  assert (select count(*) from public.ci_audit_alerts) = 1, 'the member does not see exactly their alert';
+  assert (select test_id from public.ci_audit_alerts) = 'tests/test_a.py::test_x', 'the member sees another organization''s alert';
+  assert (select audit_wrong from public.ci_runs where id = r.run) = 1, 'the member does not see the run''s audit counts';
+  begin
+    insert into public.ci_audit_alerts (workspace_id, project_id, github_job_id, test_id) values (r.w, r.p, 7003, 'x');
+    assert false, 'a member wrote an alert';
+  exception when insufficient_privilege then null; end;
+end $$;
+reset role;
+
+-- ---------------------------------------------------------------- the outsider: their own alert only
+set local role authenticated;
+set local request.jwt.claims = '{"sub":"3ddddddd-0000-4000-8000-000000000004","role":"authenticated"}';
+do $$
+begin
+  assert (select count(*) from public.ci_audit_alerts) = 1, 'the outsider does not see exactly their alert';
+  assert (select test_id from public.ci_audit_alerts) = 'tests/test_b.py::test_y', 'the outsider sees W''s alert';
+end $$;
+reset role;
+
+-- ---------------------------------------------------------------- the GitHub App: writes for the organization it acts for only
+set local role fenvix_github_app;
+do $$
+declare r au_ids%rowtype;
+begin
+  select * into r from au_ids;
+  perform set_config('app.workspace_id', r.w::text, true);
+  insert into public.ci_audit_alerts (workspace_id, project_id, run_id, github_job_id, test_id) values (public.cp_workspace(), r.p, r.run, 7004, 'tests/test_a.py::test_z');
+  assert (select count(*) from public.ci_audit_alerts) = 2, 'the App does not see exactly W''s alerts';
+  begin
+    insert into public.ci_audit_alerts (workspace_id, project_id, github_job_id, test_id) values (r.xw, r.p, 7005, 'x');
+    assert false, 'the App wrote an alert into another organization';
+  exception when insufficient_privilege or check_violation then null; end;
+  begin
+    update public.ci_audit_alerts set state = 'acknowledged';
+    assert false, 'the App changed an alert';
+  exception when insufficient_privilege then null; end;
+end $$;
+reset role;
+
+select 'AUDIT RLS OK';
+rollback;
