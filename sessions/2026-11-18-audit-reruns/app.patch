+/**
+ * One-sided 95% upper bound on the share of wrong skips after `checked` audited skips found `wrong` wrong: 3 / checked
+ * when none (rule of three), else the exact Clopper-Pearson bound. Null when nothing was checked. The engine
+ * (detpy_core::audit::upper_bound_95) and the cache service use the same rule.
+ */
+export function upperBound95(checked: number, wrong: number): number | null {
+  if (checked <= 0) return null;
+  if (wrong <= 0) return Math.min(1, 3 / checked);
+  if (wrong >= checked) return 1;
+  const cdf = (p: number) => {
+    const lp = Math.log(p), lq = Math.log1p(-p);
+    let lc = 0;
+    const terms: number[] = [];
+    for (let i = 0; i <= wrong; i++) {
+      if (i) lc += Math.log(checked - i + 1) - Math.log(i);
+      terms.push(lc + i * lp + (checked - i) * lq);
+    }
+    const m = Math.max(...terms);
+    return Math.min(1, Math.exp(m + Math.log(terms.reduce((a, t) => a + Math.exp(t - m), 0))));
+  };
+  let lo = wrong / checked, hi = 1;
+  for (let k = 0; k < 200; k++) {
+    const mid = (lo + hi) / 2;
+    if (cdf(mid) > 0.05) lo = mid; else hi = mid;
+  }
+  return hi;
+}
+
+/** Cache audits summed over runs, with the bound. */
+export function auditTotals(runs: Run[]): AuditTotals {
+  const withAudit = runs.filter((r) => r.audit && r.audit.share > 0);
+  const checked = withAudit.reduce((a, r) => a + r.audit.checked, 0);
+  const wrong = withAudit.reduce((a, r) => a + r.audit.wrong, 0);
+  return { runs: withAudit.length, checked, wrong, flakyEvidence: withAudit.reduce((a, r) => a + r.audit.flakyEvidence, 0), upperBound95: upperBound95(checked, wrong) };
+}
