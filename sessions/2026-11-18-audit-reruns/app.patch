+  if (!s.audit || !s.audit.wrongTests.length) return [];
+  const f = limit(s.audit.wrongTests, max);
+  const L = ["", "### Skips the audit found wrong", "",
+    "fenvix runs a random share of the tests it could skip and compares. These gave another result than the cached one twice: they ran in this job, and their cached result is not used again until a fresh run records it.", ""];
