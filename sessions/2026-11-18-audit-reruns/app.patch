diff --git a/supabase/migrations/0014_cache_audit.sql b/supabase/migrations/0014_cache_audit.sql
new file mode 100644
index 0000000..7091663
--- /dev/null
+++ b/supabase/migrations/0014_cache_audit.sql
@@ -0,0 +1,65 @@
+-- Cache audit (fenvix-engine-cli, claude/audit-reruns): in every run the engine runs a seeded random share (default 5%)
+-- of the tests it could skip with proof, and compares the fresh result with the cached one. The runner's summary.json
+-- carries `audit: {share, seed, checked, matched, wrong, flaky_evidence, wrong_tests, ...}`.
+--
+--   * ci_runs gets the run's audit counts. Audited tests ran: they are in tests_ran, never in tests_skipped, so the
+--     dashboard and the billing never count them as skipped.
+--   * ci_audit_alerts: one row per wrong skip (two fresh runs contradicted the cached result). The GitHub App writes it
+--     and logs the alert at ERROR; the dashboard shows it. Paging is configured later.
+--
+-- Safe to run again.
+
+alter table public.ci_runs add column if not exists audit_share numeric(6, 5) not null default 0 check (audit_share between 0 and 1);
+alter table public.ci_runs add column if not exists audit_seed text not null default '';
+alter table public.ci_runs add column if not exists audit_checked int not null default 0 check (audit_checked >= 0);
+alter table public.ci_runs add column if not exists audit_matched int not null default 0 check (audit_matched >= 0);
+alter table public.ci_runs add column if not exists audit_wrong int not null default 0 check (audit_wrong >= 0);
+alter table public.ci_runs add column if not exists audit_flaky_evidence int not null default 0 check (audit_flaky_evidence >= 0);
+do $$
+begin
+  alter table public.ci_runs add constraint ci_runs_audit_adds_up
+    check (audit_matched + audit_wrong + audit_flaky_evidence = audit_checked and audit_checked <= tests_ran);
+exception when duplicate_object then null;
+end $$;
+
+create table if not exists public.ci_audit_alerts (
+  id uuid primary key default gen_random_uuid(),
+  workspace_id uuid not null,
+  project_id uuid not null references public.ci_projects (id) on delete cascade,
+  run_id uuid references public.ci_runs (id) on delete cascade,
+  github_job_id bigint not null,
+  test_id text not null check (length(test_id) between 1 and 2000),
+  cached_outcome text not null default '',
+  fresh_outcome text not null default '',
+  fresh2_outcome text,
+  proof_key text not null default '',
+  audit_seed text not null default '',
+  -- open: just found; acknowledged: someone at fenvix looked at it (engine bug filed or explained)
+  state text not null default 'open' check (state in ('open', 'acknowledged')),
+  created_at timestamptz not null default now(),
+  unique (github_job_id, test_id)
+);
+create index if not exists ci_audit_alerts_workspace on public.ci_audit_alerts (workspace_id, created_at desc);
+create index if not exists ci_audit_alerts_project on public.ci_audit_alerts (project_id, created_at desc);
+
+alter table public.ci_audit_alerts enable row level security;
+revoke all on public.ci_audit_alerts from public, anon, authenticated;
+
+-- Members read their organization's alerts.
+grant select on public.ci_audit_alerts to authenticated;
+drop policy if exists ci_audit_alerts_member_read on public.ci_audit_alerts;
+create policy ci_audit_alerts_member_read on public.ci_audit_alerts for select to authenticated
+  using (workspace_id in (select public.my_workspace_ids()));
+
+-- The GitHub App writes them for the one organization it acts for.
+do $$
+begin
