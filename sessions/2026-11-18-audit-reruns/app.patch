+++ b/github-app/src/results/summary.ts
@@ -8,2 +8,20 @@ export interface FlakyTest { nodeid: string; replay: string; minimise: string |
 
+/** One result the cache audit found wrong: two fresh runs contradicted the cached result. */
+export interface WrongSkip { nodeid: string; key: string; cached: string; fresh: string; fresh2: string | null }
+
+/**
+ * The engine's cache audit (fenvix-engine-cli claude/audit-reruns, `summary.json` → `audit`): a seeded share of the
+ * tests that could be skipped with proof ran fresh and was compared with the cached result. Audited tests ran: they are
+ * in `ran`, never in `reusedWithProof`.
+ */
+export interface AuditSummary {
+  share: number;
+  seed: string;
+  checked: number;
+  matched: number;
+  wrong: number;
+  flakyEvidence: number;
+  wrongTests: WrongSkip[];
+}
+
 export interface RunSummary {
@@ -28,2 +46,4 @@ export interface RunSummary {
   runtimeChanged: string[];
+  /** Null for runners older than the audit. */
+  audit: AuditSummary | null;
 }
@@ -83,2 +103,26 @@ function engineVersionOf(raw: Record<string, unknown>): string {
 
+function parseAudit(o: Record<string, unknown>, ran: number): AuditSummary | null {
+  const a = o.audit;
+  if (a === undefined || a === null) return null;
+  if (typeof a !== "object" || Array.isArray(a)) throw new SummaryError("summary.audit must be an object");
+  const x = a as Record<string, unknown>;
+  const share = num(x, "share");
+  if (share > 1) throw new SummaryError("summary.audit.share must be between 0 and 1");
+  const checked = num(x, "checked", { int: true });
+  const matched = num(x, "matched", { int: true });
+  const wrong = num(x, "wrong", { int: true });
+  const flakyEvidence = num(x, "flaky_evidence", { int: true });
+  if (matched + wrong + flakyEvidence !== checked) throw new SummaryError("summary.audit: matched + wrong + flaky_evidence must equal checked");
+  if (checked > ran) throw new SummaryError("summary.audit: more tests checked than ran (audited tests ran)");
+  const wt = x.wrong_tests ?? [];
+  if (!Array.isArray(wt)) throw new SummaryError("summary.audit.wrong_tests must be a list");
+  const wrongTests: WrongSkip[] = wt.slice(0, 200).map((w, i) => {
+    const ww = (w ?? {}) as Record<string, unknown>;
+    const nodeid = str(ww.nodeid, 2000);
+    if (!nodeid) throw new SummaryError(`summary.audit.wrong_tests[${i}] needs nodeid`);
+    return { nodeid, key: str(ww.key, 128) ?? "", cached: str(ww.cached, 40) ?? "", fresh: str(ww.fresh, 40) ?? "", fresh2: str(ww.fresh2, 40) };
+  });
+  return { share, seed: str(x.seed, 200) ?? "", checked, matched, wrong, flakyEvidence, wrongTests };
+}
+
 export function parseSummary(raw: unknown): RunSummary {
@@ -125,2 +169,3 @@ export function parseSummary(raw: unknown): RunSummary {
     runtimeChanged: Array.isArray(rc) ? rc.filter((x): x is string => typeof x === "string").slice(0, 50) : [],
+    audit: parseAudit(o, ran),
   };
