{
 "name": "vue-core",
 "url": "https://github.com/vuejs/core",
 "lang": "vitest",
 "node": "lts/*",
 "seq": {
  "kind": "first-parent",
  "n": 51
 },
 "install": [
  "corepack enable >/dev/null 2>&1; pnpm install --frozen-lockfile --reporter=silent || pnpm install --reporter=silent"
 ],
 "install_files": [
  "pnpm-lock.yaml",
  "package.json",
  "packages/*/package.json",
  "pnpm-workspace.yaml"
 ],
 "units": {
  "include": [
   "packages/**/__tests__/**/*.spec.ts",
   "packages/**/__tests__/**/*.spec.tsx",
   "packages-private/**/__tests__/**/*.spec.ts"
  ],
  "sample": 1.0
 },
 "cmd": [
  "pnpm",
  "exec",
  "vitest",
  "run",
  "--project",
  "unit*",
  "--reporter=json",
  "--outputFile={out}",
  "{unit}"
 ],
 "unit_timeout": 600,
 "verify": 0.1,
 "ci": {
  "workers": 4,
  "source": ".github/workflows/test.yml unit-test: one ubuntu-latest job, pnpm run test-unit (vitest threads)"
 },
 "ci_cmd": "pnpm run test-unit --run --reporter=default --reporter=json --outputFile={report}",
 "ci_report": "vitest"
}
