{
 "name": "tap-minimatch",
 "url": "https://github.com/isaacs/minimatch",
 "node": "22",
 "runner": "tap",
 "install": [
  "npm ci --no-audit --no-fund"
 ],
 "install_files": [
  "package-lock.json",
  "package.json"
 ],
 "build": [
  "npm run prepare"
 ],
 "args": [],
 "plain": "npx tap",
 "shards": 1,
 "source": "26 first-parent commits of main up to 2026-11-16 (tap 21, TypeScript tests through tap's loaders, t.mockImport)",
 "window": [
  0,
  26
 ],
 "run_timeout": 3000,
 "overhead": "shard0",
 "unset_ci": true
}