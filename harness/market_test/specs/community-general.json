{
 "name": "community-general",
 "url": "https://github.com/ansible-collections/community.general",
 "lang": "pytest",
 "install": [
  "test -x {py} || uv venv -q --python 3.12 {venv}",
  "uv pip install -q --python {py} ansible-core pytest pytest-mock pytest-xdist",
  "python3 {harness}/pyinstall.py --python {py} -r tests/unit/requirements.txt",
  "mkdir -p {work}/ac/ansible_collections/community && {venv}/bin/ansible-galaxy collection install -r tests/unit/requirements.yml -p {work}/ac"
 ],
 "install_files": [
  "tests/unit/requirements.txt",
  "tests/unit/requirements.yml"
 ],
 "build": [
  "mkdir -p {work}/ac/ansible_collections/community && ln -sfn {src} {work}/ac/ansible_collections/community/general"
 ],
 "env": {
  "PYTHONPATH": "{work}/ac"
 },
 "roots": [
  "{work}/ac"
 ],
 "units": {
  "include": [
   "tests/unit/**/test_*.py"
  ],
  "sample": 0.5,
  "seed": "s2"
 },
 "cmd": [
  "{py}",
  "-m",
  "pytest",
  "-q",
  "-p",
  "no:cacheprovider",
  "-p",
  "s2_report",
  "{unit}"
 ],
 "unit_timeout": 900,
 "verify": 0.08,
 "ci": {
  "workers": 4,
  "source": "ansible-test units: one runner per Python version, 4 vCPU assumed"
 },
 "seq": {
  "kind": "first-parent",
  "n": 51,
  "head": "63fe14d2aa6ac026825ffb805a5c8a08a97855ba"
 }
}
