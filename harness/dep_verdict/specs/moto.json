{
 "name": "moto",
 "url": "https://github.com/getmoto/moto",
 "lang": "pytest",
 "install": [
  "test -x {py} || uv venv -q --python 3.12 {venv}",
  "uv pip install -q --python {py} -e '.[all,server]' -r requirements-tests.txt",
  "{py} -m compileall -q -j 4 {venv}/lib > /dev/null 2>&1 || true"
 ],
 "units": {
  "include": [
   "tests/**/test_*.py"
  ],
  "sample": 0.25,
  "seed": "s2"
 },
 "cmd": [
  "{py}",
  "-m",
  "pytest",
  "-q",
  "-p",
  "no:cacheprovider",
  "-p",
  "s2_report",
  "{unit}"
 ],
 "unit_timeout": 900,
 "ci": {
  "workers": 4,
  "source": "Makefile test-only: serial pytest plus one -n 4 group, one runner"
 },
 "repo": "moto",
 "max_units": 30
}
