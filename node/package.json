{
  "name": "detjs",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic execution of JavaScript/TypeScript tests (Level 0) for Vitest and Jest",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "detjs": "bin/detjs.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "esbuild-register": "^3.6.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
