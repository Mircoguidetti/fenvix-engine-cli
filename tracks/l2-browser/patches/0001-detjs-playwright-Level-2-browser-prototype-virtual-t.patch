diff --git a/node/src/pw/boot.js b/node/src/pw/boot.js
new file mode 100644
index 0000000..86fe652
--- /dev/null
+++ b/node/src/pw/boot.js
@@ -0,0 +1,29 @@
+'use strict';
+// Preloaded with NODE_OPTIONS=--require by `detjs playwright` and `detjs serve`
+// into every Node process of a Level 2 browser run; picks the role:
+//   * Playwright Test worker (lib/worker/ entry, or TEST_WORKER_INDEX) -> worker.js
+//   * the Playwright runner itself                         -> nothing (reporter.js runs there)
+//   * package managers and task launchers                  -> nothing
+//   * anything else (the app server and its children)      -> server.js
+// DETJS_PW_SERVER=0 leaves app servers uncontrolled.
+const path = require('node:path');
+
+const LAUNCHERS = /^(npm|npm-cli|npx|npx-cli|pnpm|pnpm\.c?js|yarn|yarn\.c?js|corepack|cross-env|turbo|nx|concurrently|run-p|run-s|npm-run-all2?|wait-on|start-server-and-test|tsc)(\.js)?$/;
+
+function role() {
+  if (process.env.DETJS !== '1') return null;
+  const main = process.argv[1] || '';
+  if (process.env.TEST_WORKER_INDEX !== undefined || /[\\/]playwright[\\/]lib[\\/]worker[\\/]/.test(main)) return 'worker';
+  if (/[\\/](playwright|playwright-core|@playwright[\\/]test)[\\/]/.test(main)) return null; // runner helpers (loader, test server)
+  const script = path.basename(main);
+  const args = process.argv.slice(1).join(' ');
+  if (/playwright/.test(args) && /\b(cli\.js|playwright)\b/.test(args) && /\btest\b/.test(args)) return null; // the runner
+  if (process.env.DETJS_PW_RUNNER_PID === String(process.pid)) return null;
+  if (LAUNCHERS.test(script) || /[\\/](npm|pnpm|yarn|corepack)[\\/]/.test(process.argv[1] || '')) return null;
+  if (process.env.DETJS_PW_SERVER === '0') return null;
+  return 'server';
+}
+
+const r = role();
+if (r === 'worker') require('./worker');
+else if (r === 'server') require('./server');
diff --git a/node/src/pw/cli.js b/node/src/pw/cli.js
new file mode 100644
index 0000000..7dc5ab7
--- /dev/null
+++ b/node/src/pw/cli.js
@@ -0,0 +1,197 @@
+'use strict';
+// `detjs playwright [--det options] [playwright test args]`: Level 2 for
+// browser end-to-end tests (prototype). See docs/L2-BROWSER.md.
+//
+// Without --det the project's own Playwright CLI runs unchanged. With --det:
+//   * a wrapper config (next to the project's config) imports it and forces
+//     workers=1, fullyParallel=false, retries=0, adds the detjs reporter;
+//   * NODE_OPTIONS preloads pw/boot.js in every Node process of the run: the
+//     workers get the browser controls (worker.js), the app servers started
+//     by `webServer` get the server controls (server.js);
+//   * the reporter writes the shared trace (.detjs/trace.jsonl by default).
+// `detjs serve [--det options] -- <command>` starts an app server outside the
+// runner with the same server controls (projects whose CI starts the server
+// before `playwright test`).
+const fs = require('node:fs');
+const path = require('node:path');
+const { spawn } = require('node:child_process');
+const session = require('../session');
+const native = require('../native');
+
+const PW_HELP = `detjs playwright options (besides the detjs options of --det-help):
+  --det-vtime=fast|paced|off   browser virtual time (default fast: idle time is skipped;
+                               paced: virtual time never runs ahead of real time)
+  --det-net=on|off             serialize and order the app's HTTP traffic (default on)
+  --det-net-window=MS          quiet window before choosing the next request (default 15)
+  --det-browser-seeds=on|off   seeded Math.random / crypto in pages and test code (default on)
+  --det-server=on|off          Level 0 controls and test brackets in app servers (default on)
+  --det-epoch=now              use the current minute as epoch (printed, needed to replay)
+`;
+
+const PW_FLAGS = {
+  '--det-vtime': 'DETJS_PW_VTIME',
+  '--det-net': 'DETJS_PW_NET',
+  '--det-net-window': 'DETJS_PW_NET_WINDOW',
+  '--det-browser-seeds': 'DETJS_PW_SEEDS',
+  '--det-server': 'DETJS_PW_SERVER',
+};
+
+function splitPwFlags(argv) {
+  const env = {};
+  const rest = [];
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i];
+    const [k, v] = a.includes('=') ? [a.slice(0, a.indexOf('=')), a.slice(a.indexOf('=') + 1)] : [a, undefined];
+    if (PW_FLAGS[k]) {
+      const val = v !== undefined ? v : argv[++i];
+      env[PW_FLAGS[k]] = val === 'on' ? '1' : val === 'off' ? (k === '--det-server' ? '0' : 'off') : val;
+      continue;
+    }
+    if (k === '--det-epoch' && v === 'now') {
+      const d = new Date();
+      d.setUTCSeconds(0, 0);
+      rest.push(`--det-epoch=${d.toISOString()}`);
+      continue;
+    }
+    if (a === '--det-help') { process.stdout.write(session.HELP + PW_HELP); process.exit(0); }
+    rest.push(a);
+  }
+  return { env, rest };
+}
+
+function resolvePlaywrightCli(cwd) {
+  const req = require('node:module').createRequire(path.join(cwd, 'noop.js'));
+  let base;
+  try { base = req.resolve('@playwright/test/package.json'); } catch { base = req.resolve('playwright/package.json'); }
+  const r2 = require('node:module').createRequire(base);
+  const pwPkg = r2.resolve('playwright/package.json');
+  return { cli: path.join(path.dirname(pwPkg), 'cli.js'), version: require(pwPkg).version };
+}
+
+const CONFIG_NAMES = ['playwright.config.ts', 'playwright.config.js', 'playwright.config.mts', 'playwright.config.mjs', 'playwright.config.cts', 'playwright.config.cjs'];
+
+function findConfig(args, cwd) {
+  for (let i = 0; i < args.length; i++) {
+    const a = args[i];
+    if (a === '-c' || a === '--config') return { file: path.resolve(cwd, args[i + 1]), index: i, n: 2 };
+    if (a.startsWith('--config=')) return { file: path.resolve(cwd, a.slice(9)), index: i, n: 1 };
+  }
+  for (const n of CONFIG_NAMES) {
+    const f = path.join(cwd, n);
+    if (fs.existsSync(f)) return { file: f, index: -1, n: 0 };
+  }
+  return null;
+}
+
+function writeWrapper(configFile) {
+  const dir = path.dirname(configFile);
+  const ext = path.extname(configFile);
+  const tsLike = ['.ts', '.mts', '.cts'].includes(ext);
+  const out = path.join(dir, `playwright.detjs.config${tsLike ? '.ts' : '.mjs'}`);
+  const wrap = path.join(__dirname, 'wrap.cjs').split(path.sep).join('/');
+  const rel = `./${path.basename(configFile)}`;
+  fs.writeFileSync(out, [
+    '// Generated by `detjs playwright --det` (removed at exit): the project config with Level 2 settings.',
+    `import base from ${JSON.stringify(rel)};`,
+    `import detjs from ${JSON.stringify(wrap)};`,
+    'export default detjs.wrap(base);',
+    '',
+  ].join('\n'));
+  return out;
+}
+
+async function main(argv) {
+  const { env: pwEnv, rest: afterPw } = splitPwFlags(argv);
+  const { opts, rest } = session.parseArgs(afterPw);
+  const cwd = process.cwd();
+  const { cli, version } = resolvePlaywrightCli(cwd);
+  if (!opts.det) return run(process.execPath, [cli, ...rest], process.env);
+
+  const root = process.env.DETJS_ROOT || cwd;
+  const runEnv = session.prepare(opts, root, 'playwright');
+  const cfg = findConfig(rest, cwd);
+  if (!cfg) throw new Error('detjs playwright: no playwright.config.* found (pass --config)');
+  const wrapper = writeWrapper(cfg.file);
+  const args = rest.slice();
+  if (cfg.index >= 0) args.splice(cfg.index, cfg.n);
+  if (args[0] !== 'test') args.unshift('test');
+  // CLI reporters replace the config's: keep ours in the list.
+  const reporter = path.join(__dirname, 'reporter.js');
+  let hasReporter = false;
+  for (let i = 0; i < args.length; i++) {
+    if (args[i] === '--reporter') { args[i + 1] = `${args[i + 1]},${reporter}`; hasReporter = true; }
+    else if (args[i].startsWith('--reporter=')) { args[i] = `${args[i]},${reporter}`; hasReporter = true; }
+  }
+  args.push(`--config=${wrapper}`, '--workers=1', '--retries=0');
+  const boot = path.join(__dirname, 'boot.js');
+  const env = {
+    ...process.env,
+    ...pwEnv,
+    DETJS_PW_REPORTER: hasReporter ? '' : reporter,
+    DETJS_PW_TRACE: runEnv.tracePath,
+    DETJS_PW_META: JSON.stringify({
+      seed: Number(runEnv.cfg.seed), shuffle: runEnv.cfg.shuffle, epoch: opts.epoch,
+      vtime: pwEnv.DETJS_PW_VTIME || 'fast', net: pwEnv.DETJS_PW_NET !== 'off', net_window_ms: Number(pwEnv.DETJS_PW_NET_WINDOW || 15),
+      browser_seeds: pwEnv.DETJS_PW_SEEDS !== 'off', server_controls: pwEnv.DETJS_PW_SERVER !== '0',
+      playwright: version, node: process.version, platform: process.platform,
+    }),
+    NODE_OPTIONS: `${process.env.NODE_OPTIONS || ''} --require ${JSON.stringify(boot).slice(1, -1)}`.trim(),
+  };
+  if (process.env.DETJS_ROOT === undefined) env.DETJS_ROOT = root;
+  process.stderr.write(`detjs ${session.VERSION}: Level 2 browser prototype; playwright ${version}; seed ${env.DETJS_SEED}${runEnv.cfg.shuffle ? ' (seeded order)' : ''}; epoch ${opts.epoch}; vtime=${env.DETJS_PW_VTIME || 'fast'}; net=${env.DETJS_PW_NET || 'on'}; server=${env.DETJS_PW_SERVER === '0' ? 'off' : 'on'}; workers=1\n`);
+  let code;
+  try {
+    code = await run(process.execPath, [cli, ...args], env);
+  } finally {
+    fs.rmSync(wrapper, { force: true });
+  }
+  // Keep the app servers' trace parts for diagnosis; drop the worker buckets.
+  const parts = path.join(runEnv.dir, 'parts');
+  if (fs.existsSync(parts) && fs.readdirSync(parts).length) {
+    const keep = path.join(path.dirname(runEnv.tracePath), 'server-parts');
+    fs.rmSync(keep, { recursive: true, force: true });
+    fs.renameSync(parts, keep);
+  }
+  fs.rmSync(runEnv.dir, { recursive: true, force: true });
+  if (fs.existsSync(runEnv.tracePath)) {
+    process.stderr.write(`detjs: trace ${path.relative(cwd, runEnv.tracePath)}\n`);
+    if (opts.compare) {
+      try {
+        process.stderr.write(native.verifyText([opts.compare, runEnv.tracePath], false));
+      } catch (e) { process.stderr.write(`detjs: compare failed: ${e.message}\n`); }
+    }
+  }
+  return code;
+}
+
+/** `detjs serve [--det options] -- command args`: an app server under the server controls. */
+async function serve(argv) {
+  const sep = argv.indexOf('--');
+  const detArgs = sep >= 0 ? argv.slice(0, sep) : [];
+  const cmd = sep >= 0 ? argv.slice(sep + 1) : argv;
+  const { env: pwEnv, rest } = splitPwFlags(detArgs);
+  const { opts } = session.parseArgs(rest);
+  opts.det = true;
+  const root = process.env.DETJS_ROOT || process.cwd();
+  const runEnv = session.prepare(opts, root, 'server');
+  const env = {
+    ...process.env, ...pwEnv, DETJS_ROOT: root,
+    DETJS_DIR: path.join(root, '.detjs', 'serve'),
+    NODE_OPTIONS: `${process.env.NODE_OPTIONS || ''} --require ${path.join(__dirname, 'boot.js')}`.trim(),
+  };
+  fs.rmSync(runEnv.dir, { recursive: true, force: true });
+  fs.mkdirSync(path.join(env.DETJS_DIR, 'parts'), { recursive: true });
+  return run(cmd[0], cmd.slice(1), env);
+}
+
+function run(cmd, args, env) {
+  return new Promise((resolve) => {
+    const child = spawn(cmd, args, { stdio: 'inherit', env });
+    const fwd = (sig) => { try { child.kill(sig); } catch { /* gone */ } };
+    process.on('SIGINT', fwd);
+    process.on('SIGTERM', fwd);
+    child.on('exit', (code, signal) => resolve(code === null ? (signal ? 1 : 0) : code));
+  });
+}
+
+module.exports = { main, serve, PW_HELP };
diff --git a/node/src/pw/page-init.js b/node/src/pw/page-init.js
new file mode 100644
index 0000000..c302b47
--- /dev/null
+++ b/node/src/pw/page-init.js
@@ -0,0 +1,107 @@
+'use strict';
+// Init script for the pages of a Level 2 browser run (Playwright
+// `context.addInitScript`): runs in every frame before the page's own scripts.
+//
+// * Math.random: xoshiro128** (the same generator as the Node shell) seeded
+//   with derive_seed(seed, test id) mixed with a hash of the document URL
+//   (origin + path), so every document of a test draws a fixed sequence;
+// * crypto.getRandomValues / crypto.randomUUID: a second stream of the same key;
+// * window.__detjs.stats(): draw counters and a running digest of the values
+//   handed out, read by the worker at the end of the test for the fingerprint.
+//
+// Date, performance.now and timers are not touched here: the browser's own
+// virtual time (CDP Emulation.setVirtualTimePolicy) controls them, so that
+// they stay consistent with layout, animations and requestAnimationFrame.
+// Web workers and service workers are not reached (limit B3 in docs/L2-BROWSER.md).
+
+function pageInit(seedHi, seedLo) {
+  // Stringified and evaluated in the page: no closures over Node values.
+  /* eslint-disable no-var */
+  (function () {
+    if (window.__detjs) return;
+    var SEED_HI = __SEED_HI__ >>> 0;
+    var SEED_LO = __SEED_LO__ >>> 0;
+    function rotl(x, k) { return ((x << k) | (x >>> (32 - k))) >>> 0; }
+    function X() { this.s = new Uint32Array(4); }
+    X.prototype.seed = function (hi, lo) {
+      var x = (hi ^ Math.imul(lo, 0x9e3779b9)) >>> 0;
+      for (var i = 0; i < 4; i++) {
+        x = (x + 0x9e3779b9) >>> 0;
+        var z = x;
+        z = Math.imul(z ^ (z >>> 16), 0x85ebca6b) >>> 0;
+        z = Math.imul(z ^ (z >>> 13), 0xc2b2ae35) >>> 0;
+        this.s[i] = (z ^ (z >>> 16) ^ (i === 0 ? lo : i === 1 ? hi : 0)) >>> 0;
+      }
+      if (!(this.s[0] | this.s[1] | this.s[2] | this.s[3])) this.s[0] = 1;
+    };
+    X.prototype.next = function () {
+      var s = this.s;
+      var r = Math.imul(rotl(Math.imul(s[1], 5) >>> 0, 7), 9) >>> 0;
+      var t = (s[1] << 9) >>> 0;
+      s[2] ^= s[0]; s[3] ^= s[1]; s[1] ^= s[2]; s[0] ^= s[3]; s[2] ^= t; s[3] = rotl(s[3], 11);
+      return r;
+    };
+    function fnv(str) {
+      var h = 0x811c9dc5;
+      for (var i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
+      return h >>> 0;
+    }
+    var docKey = fnv(String(location.origin) + String(location.pathname));
+    var M = new X(); M.seed(SEED_HI ^ docKey, SEED_LO);
+    var C = new X(); C.seed(SEED_HI, (SEED_LO ^ docKey ^ 0x5bd1e995) >>> 0);
+    var stats = { random: 0, crypto: 0, uuid: 0, digest: 0x811c9dc5 };
+    function mix(v) { stats.digest = Math.imul((stats.digest ^ v) >>> 0, 0x01000193) >>> 0; }
+
+    var random = function random() {
+      var a = M.next() >>> 5;
+      var b = M.next() >>> 6;
+      stats.random++; mix(a);
+      return (a * 67108864 + b) / 9007199254740992;
+    };
+    try { Object.defineProperty(Math, 'random', { value: random, writable: true, configurable: true }); } catch (e) { /* frozen */ }
+
+    var C_PROTO = window.Crypto && window.Crypto.prototype;
+    if (C_PROTO && typeof C_PROTO.getRandomValues === 'function') {
+      var realGRV = C_PROTO.getRandomValues;
+      var grv = function getRandomValues(arr) {
+        if (!arr || !ArrayBuffer.isView(arr) || arr instanceof Float32Array || arr instanceof Float64Array) {
+          return realGRV.call(this, arr); // let the browser throw its own TypeError
+        }
+        if (arr.byteLength > 65536) return realGRV.call(this, arr);
+        var b = new Uint8Array(arr.buffer, arr.byteOffset, arr.byteLength);
+        for (var i = 0; i < b.length; i += 4) {
+          var v = C.next();
+          for (var k = 0; k < 4 && i + k < b.length; k++) b[i + k] = (v >>> (8 * k)) & 0xff;
+        }
+        stats.crypto++; mix(b.length);
+        return arr;
+      };
+      Object.defineProperty(C_PROTO, 'getRandomValues', { value: grv, writable: true, configurable: true });
+      if (typeof C_PROTO.randomUUID === 'function') {
+        var uuid = function randomUUID() {
+          var b = new Uint8Array(16);
+          for (var i = 0; i < 16; i += 4) { var v = C.next(); for (var k = 0; k < 4; k++) b[i + k] = (v >>> (8 * k)) & 0xff; }
+          b[6] = (b[6] & 0x0f) | 0x40; b[8] = (b[8] & 0x3f) | 0x80;
+          var h = [];
+          for (var j = 0; j < 16; j++) h.push((b[j] + 0x100).toString(16).slice(1));
+          stats.uuid++; mix(b[0]);
+          return h.slice(0, 4).join('') + '-' + h.slice(4, 6).join('') + '-' + h.slice(6, 8).join('') + '-' + h.slice(8, 10).join('') + '-' + h.slice(10).join('');
+        };
+        Object.defineProperty(C_PROTO, 'randomUUID', { value: uuid, writable: true, configurable: true });
+      }
+    }
+    Object.defineProperty(window, '__detjs', {
+      value: { stats: function () { return { random: stats.random, crypto: stats.crypto, uuid: stats.uuid, digest: stats.digest.toString(16) }; } },
+      enumerable: false,
+    });
+  })();
+}
+
+/** Source of the init script for one test (seed words from derive_seed). */
+function pageInitSource(seedHi, seedLo) {
+  return `(${pageInit.toString()})();`
+    .replace('__SEED_HI__', String(seedHi >>> 0))
+    .replace('__SEED_LO__', String(seedLo >>> 0));
+}
+
+module.exports = { pageInitSource };
