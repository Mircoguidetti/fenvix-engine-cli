         fails = sum(is_fail(o) for o in row["outcomes"].values())
         log(f"{p.name} u{unit['id']} {mode} seed={seed} run={i}: {r['duration_s']}s exit={r['exit']} "
@@ -200,7 +209,9 @@ def measure_corpus(project: dict, args) -> dict:
