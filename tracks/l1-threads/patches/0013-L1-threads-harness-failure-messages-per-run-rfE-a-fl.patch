                 d = (verdict.get(t) or {}).get("divergence") or {}
+                failmsgs = [r["msgs"].get(t, "") for r in rows if is_fail(r["outcomes"].get(t))]
                 confirm[t] = {"seed": s, "fails": fails, "runs": len(rows), "distinct_fps": len(fps),
