--- a/tests/test_threads.py
+++ b/tests/test_threads.py
@@ -418,3 +418,62 @@ def test_thread_exit_is_serialised(pytester):
         _, _, fp = _run(pytester, "--det-threads-seed=3")
         fps.add(json.dumps(fp, sort_keys=True))
