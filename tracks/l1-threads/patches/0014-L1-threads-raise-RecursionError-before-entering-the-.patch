diff --git a/python/detpy/threads.py b/python/detpy/threads.py
index 2816cfb..c04202c 100644
--- a/python/detpy/threads.py
+++ b/python/detpy/threads.py
@@ -494,6 +494,25 @@ def _switch(me) -> None:
         _wait_gate(me)
 
 
+_HEADROOM = 60  # frames kept free below the recursion limit for the scheduler itself
+
+
+def _near_recursion_limit() -> bool:
+    try:
+        sys._getframe(150)  # cheap common case: a shallow stack
+        sys._getframe(sys.getrecursionlimit() - _HEADROOM)
+    except ValueError:
+        return False
+    return True
+
+
+def _check_depth() -> None:
+    """A RecursionError inside the scheduler (while it holds its lock or has changed a
+    thread's state) would wedge every thread: raise it before entering instead."""
+    if _near_recursion_limit():
+        raise RecursionError("maximum recursion depth exceeded")
+
+
 def _enter(me) -> None:
     """Start of every controlled operation of a managed thread: rejoin if escaped."""
     S.ops += 1
@@ -528,6 +547,7 @@ def _point(me) -> None:
     if not S.runq:
         if not (CFG.seed and S.since_switch & 31 == 0 and _has(IOWAIT)):
             return
+    _check_depth()
     if CFG.seed:
         if _DEBUG:
             _dbg(f"point {me.idx} at {_site()}")
@@ -599,6 +619,7 @@ def sleep(ns: int) -> bool:
     if me is None:
         return False
     _enter(me)
+    _check_depth()
     S.mu.acquire()
     if not S.active:
         S.mu.release()
@@ -654,6 +675,7 @@ def io_wait(pred, timeout=None, what="I/O", real_time=False) -> bool:
         return True
     if timeout is not None and timeout <= 0:
         return False
+    _check_depth()
     S.mu.acquire()
     if not S.active:
         S.mu.release()
@@ -737,6 +759,7 @@ class SchedLock:
             return True
         if not blocking:
             return False
+        _check_depth()
         if timeout is not None and timeout >= 0:
             deadline = _now() + _ns(timeout)
         else:
@@ -765,6 +788,8 @@ class SchedLock:
                 return False
 
     def release(self):
+        if (self._nwait or S.runq) and _me() is not None:
+            _check_depth()
         self._real.release()
         if self._nwait:
             S.mu.acquire()
@@ -877,6 +902,7 @@ def _wrap_start_thread(real):
         if me is None or _started_by_infra():
             return real(function, *args, **kwargs)
         _enter(me)
+        _check_depth()
         thread_obj = getattr(_tls, "starting", None)
         _tls.starting = None
         name = getattr(thread_obj, "name", "thread")
@@ -973,6 +999,7 @@ def _wrap_join(real):
         t = getattr(self, "_detpy_t", None)
         if me is not None and t is not None and t is not me:
             _enter(me)
+            _check_depth()
             S.mu.acquire()
             if S.active and t.state != FINISHED:
                 ok = _block(me, BLOCKED, f"join of thread {t.idx} ({t.name})", obj=t,
@@ -1040,7 +1067,8 @@ def _install_tracer(t) -> None:
             t.budget -= 1
             if t.budget <= 0:
                 t.budget = _new_budget()
-                if S.active and S.current is t and S.runq and not getattr(_tls, "in_mu", False):
+                if (S.active and S.current is t and S.runq and not getattr(_tls, "in_mu", False)
+                        and not _near_recursion_limit()):
                     _preempt(t)
         return line
 
diff --git a/tests/test_threads.py b/tests/test_threads.py
index 81316b0..7e88cfd 100644
--- a/tests/test_threads.py
+++ b/tests/test_threads.py
@@ -525,3 +525,44 @@ def test_io_in_flight_and_event_loop_waits(pytester):
     pytester.makepyfile(test_io=IO_IN_FLIGHT)
     result = pytester.runpytest_subprocess(*FLAGS, "-p", "no:cacheprovider", timeout=120)
     result.assert_outcomes(passed=2)
+
+
+DEEP_RECURSION = r'''
+import threading
+
+def test_recursion_through_locks():
+    lock = threading.Lock()
+    cond = threading.Condition()
+    def rec(n):
+        if n % 7 == 0:
+            with lock:
+                pass
+        if n % 11 == 0:
+            with cond:
+                cond.notify_all()
+        a = n
+        b = a + 1
+        return rec(b)
+    errors = []
+    def w():
+        try:
+            rec(0)
+        except RecursionError:
+            errors.append(1)
+    ts = [threading.Thread(target=w) for _ in range(3)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join()
+    assert errors == [1, 1, 1]
+'''
+
+
+@pytest.mark.skipif(WITHOUT_PROTOTYPE, reason="needs --det-threads")
+@pytest.mark.parametrize("seed", ["0", "1", "2", "3"])
+def test_recursion_limit_does_not_wedge_the_scheduler(pytester, seed):
+    """A RecursionError raised inside the scheduler (lock held, state half-changed)
+    used to wedge every thread; it is now raised before entering."""
+    pytester.makepyfile(test_deep=DEEP_RECURSION)
+    result = pytester.runpytest_subprocess(*FLAGS, f"--det-threads-seed={seed}", "-p", "no:cacheprovider", timeout=90)
+    result.assert_outcomes(passed=1)
