+        self.exiting: list = []  # Thread objects finished for the scheduler, not yet ended
 
 
 S = _Sched()
@@ -373,6 +376,9 @@ def _locked_choose(me, cands):
     else:
         i = S.rng.below(n)
     chosen = cands[i]
+    if _DEBUG:
+        _dbg(f"choose {i} of {[t.idx for t in cands]} rng={S.rng.s} by {getattr(me, 'idx', None)} "
