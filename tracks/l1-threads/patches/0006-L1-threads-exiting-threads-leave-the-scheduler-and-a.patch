@@ -402,6 +409,26 @@ def _wait_gate(me) -> None:
     """Wait (no lock held) until the baton is handed to ``me``."""
     me.gate.acquire()
     me.handed = False
+    if S.exiting:
+        _reap()
+
+
+def _reap() -> None:
+    """Wait until threads that finished for the scheduler have really ended.
+
+    A finished thread still runs interpreter teardown (its frames, thread state,
+    ``threading._active`` entry) after handing the baton on; letting it do so
+    while the next thread runs makes memory reuse, and so object addresses, id()
+    order and garbage collection timing, depend on the OS. The baton holder waits
+    for it first (short; the outcome does not depend on timing)."""
+    while S.exiting:
+        th = S.exiting.pop(0)
+        try:
+            _real_join(th, 2.0)
+            if _real_is_alive(th):
+                _record_uncontrolled(f"thread {th.name} still ending after 2 s")
+        except Exception:  # pragma: no cover
+            pass
 
 
 def _switch(me) -> None:
@@ -442,6 +469,8 @@ def _rejoin(me) -> None:
         S.current = me
         S.idle_since = None
         S.mu.release()
+        if S.exiting:
+            _reap()
         return
     _locked_make_runnable(me)
     S.mu.release()
@@ -451,11 +480,15 @@ def _rejoin(me) -> None:
 def _point(me) -> None:
     """A controlled point where the running thread may be switched out (exploration,
     or a holder that ran too long while others wait)."""
+    if S.current is not me:
+        return  # not the baton holder (exiting, escaped): never consume a seeded choice
     S.since_switch += 1
     if not S.runq:
         if not (CFG.seed and S.since_switch & 31 == 0 and _has(IOWAIT)):
             return
     if CFG.seed:
+        if _DEBUG:
+            _dbg(f"point {me.idx} at {_site()}")
         if S.rng.random() >= S.p_switch and S.since_switch < CFG.starve_ops:
             return
     elif S.since_switch < CFG.starve_ops:
@@ -852,7 +885,12 @@ def _wrap_start_thread(real):
 
 
 def _exit(t) -> None:
+    # From here on the thread is outside the scheduler (teardown code may still
+    # take locks): it must neither wait for the baton nor consume seeded choices.
+    _tls.t = None
     S.mu.acquire()
+    if t.thread is not None and S.active:
+        S.exiting.append(t.thread)
     was_holder = S.current is t
     t.state = FINISHED
     t.wait_obj = None
@@ -1242,10 +1280,45 @@ class _InsertionOrderedSet(set):
         super().clear()
         self._order = []
 
+    def pop(self):
+        if not self._order:
+            raise KeyError("pop from an empty set")
+        x = self._order.pop(0)
+        super().discard(x)
+        return x
+
     def __iter__(self):
         return iter(list(self._order))
 
 
+_FUTURE_SEQ = [0]
+
+
+def _wrap_future_init(real):
+    def __init__(self, *args, **kwargs):
+        real(self, *args, **kwargs)
+        if S.active:
+            _FUTURE_SEQ[0] += 1
+            self._detpy_seq = _FUTURE_SEQ[0]
+
+    __init__.__wrapped__ = real
+    return __init__
+
+
+def _future_hash(self):
+    seq = getattr(self, "_detpy_seq", None)
+    return object.__hash__(self) if seq is None else seq
+
+
+def _future_key(f):
+    seq = getattr(f, "_detpy_seq", None)
+    return (1, id(f)) if seq is None else (0, seq)
+
+
+def _acquire_futures_init(self, futures):
+    self.futures = sorted(futures, key=_future_key)
+
+
 def _wrap_pool_init(real):
     def __init__(self, *args, **kwargs):
         real(self, *args, **kwargs)
@@ -1311,6 +1384,16 @@ def install(patcher, seed: int, grace: float, deadlock: float, preempt: int) ->
     import concurrent.futures.thread as _cft
 
     patcher.set(_cft.ThreadPoolExecutor, "__init__", _wrap_pool_init(_cft.ThreadPoolExecutor.__init__))
+    import concurrent.futures._base as _cfb
+
+    # Futures hash by address: wait()/as_completed() iterate sets of futures and
+    # _AcquireFutures locks them in id() order, so which future is seen first (and
+    # where the caller blocks) would follow the heap layout. Give every future
+    # created under the scheduler a creation number and use it instead.
+    patcher.set(_cfb.Future, "__init__", _wrap_future_init(_cfb.Future.__init__))
+    patcher.set(_cfb.Future, "__hash__", _future_hash)
+    if hasattr(_cfb, "_AcquireFutures"):
+        patcher.set(_cfb._AcquireFutures, "__init__", _acquire_futures_init)
     from . import clock
 
     patcher.set(clock, "_sched_sleep", sleep)
diff --git a/tests/test_threads.py b/tests/test_threads.py
index 7d6b5f3..654fcb6 100644
--- a/tests/test_threads.py
+++ b/tests/test_threads.py
@@ -353,3 +353,68 @@ def test_det_threads_needs_det(pytester):
     pytester.makepyfile(test_x="def test_x():\n    pass\n")
     result = pytester.runpytest_subprocess("--det-threads", "-p", "no:cacheprovider")
     assert "--det-threads needs --det" in result.stderr.str()
+
+
+FUTURE_ORDER = r'''
+import json
+from concurrent.futures import Future, as_completed, wait
+from concurrent.futures._base import _AcquireFutures
+
+def test_future_order():
+    # Free every other future and allocate new ones: the new ones reuse the
+    # freed memory, so creation order and address order disagree.
+    fs = [Future() for _ in range(64)]
+    keep = fs[1::2]
+    del fs
+    fs = keep + [Future() for _ in range(32)]
+    for f in fs:
+        f.set_result(None)
+    order = {id(f): i for i, f in enumerate(fs)}
+    seen = [order[id(f)] for f in as_completed(fs)]
+    done, _ = wait(fs)
+    seen_wait = [order[id(f)] for f in done]
+    locked = [order[id(f)] for f in _AcquireFutures(list(reversed(fs))).futures]
+    print("RESULT futures", json.dumps([seen, seen_wait, locked]), flush=True)
+    # as_completed yields already finished futures from the end of its list
+    monotone = lambda xs: xs == sorted(xs) or xs == sorted(xs, reverse=True)
+    assert monotone(seen) and monotone(seen_wait) and locked == sorted(locked)
+'''
+
+
+@pytest.mark.skipif(WITHOUT_PROTOTYPE, reason="needs --det-threads")
+def test_futures_follow_creation_order_not_addresses(pytester):
+    """as_completed/wait iterate sets of futures and _AcquireFutures sorts them by
+    id(): under --det-threads all three follow the creation order."""
+    pytester.makepyfile(test_fut=FUTURE_ORDER)
+    result = pytester.runpytest_subprocess(*FLAGS, "-p", "no:cacheprovider", "-s")
+    result.assert_outcomes(passed=1)
+
+
+EXIT_TEARDOWN = r'''
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+def test_many_short_pools():
+    out = []
+    lock = threading.Lock()
+    def job(i):
+        with lock:
+            out.append(i)
+        return i
+    for r in range(15):
+        with ThreadPoolExecutor(3) as ex:
+            list(ex.map(job, range(6)))
+    print("RESULT pools", len(out), flush=True)
+'''
+
+
+@pytest.mark.skipif(WITHOUT_PROTOTYPE, reason="needs --det-threads")
+def test_thread_exit_is_serialised(pytester):
+    """Threads that end while others run: their teardown must not shift the
+    seeded choices (an exiting thread used to consume the seeded stream)."""
+    pytester.makepyfile(test_exit=EXIT_TEARDOWN)
+    fps = set()
+    for _ in range(6):
+        _, _, fp = _run(pytester, "--det-threads-seed=3")
+        fps.add(json.dumps(fp, sort_keys=True))
+    assert len(fps) == 1
