<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.fenvix</groupId>
  <artifactId>fenvix-jvm-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>fenvix JVM shell</name>
  <modules>
    <module>rt</module>
    <module>agent</module>
    <module>maven-ext</module>
  </modules>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <asm.version>9.8</asm.version>
    <junit.platform.version>1.10.3</junit.platform.version>
    <junit.jupiter.version>5.10.3</junit.jupiter.version>
  </properties>
  <build>
    <pluginManagement>
      <plugins>
        <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
        <plugin><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
        <plugin><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version></plugin>
        <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
