+
 #include <memory>
 
 #include "base/feature_list.h"
@@ -1545,11 +1547,23 @@ FrameSchedulerImpl::CanRunWhenVirtualTimePausedTaskQueueTraits() {
   return QueueTraits().SetCanRunWhenVirtualTimePaused(true);
 }
 
+namespace {
+// fenvix lockstep: with --lockstep-loading-follows-virtual-time, loading tasks (response headers, body chunks,
+// load completion) are fenced like timers while virtual time is paused, so a page only sees the network inside a
+// virtual-time budget granted by the engine, never at a real-time dependent moment of a pause.
+bool LockstepLoadingFollowsVirtualTime() {
+  static const bool value = base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "lockstep-loading-follows-virtual-time");
+  return value;
+}
+}  // namespace
+
 MainThreadTaskQueue::QueueTraits FrameSchedulerImpl::LoadingTaskQueueTraits() {
   return QueueTraits()
       .SetCanBePaused(true)
       .SetCanBeFrozen(true)
       .SetCanBeDeferred(true)
+      .SetCanRunWhenVirtualTimePaused(!LockstepLoadingFollowsVirtualTime())
       .SetPrioritisationType(QueueTraits::PrioritisationType::kLoading);
 }
 
