def cmd_verify(a: argparse.Namespace, extra: list[str]) -> int:
    """Run the full suite again *without* the cache, at the same epoch and with the same arguments, and check that
    every reused outcome is the outcome a real run gives. A mismatch is run a second time: if the second fresh run
    agrees with the first, the reuse was wrong; otherwise the test is flaky."""
    project = Path(a.project).resolve()
    s = json.loads(Path(a.summary).read_text())
    out = Path(a.out or Path(a.summary).parent).resolve()
    reused: dict[str, str] = s["reused_outcomes"]
    ep = []
    if s.get("epoch_ns"):
        t = dt.datetime.fromtimestamp(s["epoch_ns"] // 1_000_000_000, tz=dt.timezone.utc)
        ep = [f"--det-epoch={t.strftime('%Y-%m-%dT%H:%M:%S')}"]
    args = s.get("runner_args") or s.get("pytest_args") or []
    keep = [x for x in args if not x.startswith(("--det-cache", "--det-outcomes", "--junitxml", "--det-trace"))]
    env = dict(os.environ)
    env.pop("PYTHONHASHSEED", None)

    if s.get("language") == "node":
        ctx = NodeCtx(a, project)
        keep = node_strip(keep)

        def fresh(tag: str, ids: list[str] | None = None) -> dict:
            t = out / f"trace-verify-{tag}.jsonl"
            t.unlink(missing_ok=True)
            ctx.run([*keep, f"--det-trace={t}"], env)
            return {n: r["outcome"] for n, r in read_trace(t)[1].items()}
    else:
        py = a.python or sys.executable

        def fresh(tag: str, ids: list[str] | None = None) -> dict:
            p = out / f"outcomes-verify-{tag}.json"
            p.unlink(missing_ok=True)
            run_pytest(py, project, keep + ep + [f"--det-outcomes={p}"] + (ids or []), env)
            try:
                return json.loads(p.read_text()).get("outcomes", {})
            except (OSError, ValueError):
                return {}

    f1 = fresh("1")
    checked = [n for n in reused if n in f1]
    mism = [n for n in checked if f1[n] != reused[n]]
    wrong, flaky = [], []
    if mism:
        f2 = fresh("2")
        for n in mism:
            (wrong if f2.get(n) == f1[n] else flaky).append(n)
    v = {"reused": len(reused), "checked": len(checked), "same": len(checked) - len(mism), "wrong": wrong,
         "flaky": flaky, "missing_in_fresh_run": sorted(set(reused) - set(f1)),
         "all_outcomes_same": all(f1.get(n) == o for n, o in s["outcomes"].items() if n in f1)}
    (out / "verify.json").write_text(json.dumps(v, indent=1))
    text = (f"## fenvix: every skip checked\n\nThe whole suite was run again without the cache. Of "
            f"**{v['reused']}** results reused with proof, **{v['checked']}** were checked, **{v['same']}** matched; "
            f"**wrong: {len(wrong)}**, flaky: {len(flaky)}, not in the fresh run: {len(v['missing_in_fresh_run'])}.\n")
    if wrong:
        text += "\nWrong reuses:\n" + "".join(f"- `{n}`: reused {reused[n]}, real {f1[n]}\n" for n in wrong)
    target = os.environ.get("GITHUB_STEP_SUMMARY")
    if target:
        with open(target, "a") as fh:
            fh.write(text)
    print(text)
    return 1 if wrong or v["checked"] < v["reused"] else 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    extra: list[str] = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    verify = bool(argv) and argv[0] == "verify"
    if verify:
        argv = argv[1:]
    p = argparse.ArgumentParser(prog="fenvix-run" + (" verify" if verify else ""))
    p.add_argument("--project", default=".", help="project directory (default: .)")
    p.add_argument("--lang", choices=("auto", "python", "node"), default="auto",
                   help="language of this job's tests (default auto: --python given -> python, else detected; a "
                        "repository with both needs one job per language)")
    p.add_argument("--python", default=None, help="interpreter with the project, pytest and detpy installed "
                                                   "(default: this interpreter)")
    p.add_argument("--node", default=None, help="node binary (default $FENVIX_NODE_BIN, else node on PATH)")
    p.add_argument("--detjs", default=None, help="detjs entry point (default $FENVIX_DETJS, else detjs on PATH)")
    p.add_argument("--out", default=None, help="where summary.json, receipts.jsonl and outcomes go "
                                               "(default: $RUNNER_TEMP/fenvix)")
    if verify:
        p.add_argument("--summary", required=True, help="summary.json written by the cache run")
        a = p.parse_args(argv)
        return cmd_verify(a, extra)
    p.add_argument("--key", default=None, help="cache key of the project (default: its origin URL)")
    p.add_argument("--cache", default=None, help=f"cache directory (default: {DEFAULT_ROOT}/<key>-<python>)")
    p.add_argument("--title", default=None, help="heading of the step summary")
    p.add_argument("--no-rerun", action="store_true", help="do not re-run failures alone")
    p.add_argument("--max-reruns", type=int, default=20, help="failures re-run alone at most (default 20)")
    g = p.add_argument_group("node")
    g.add_argument("--runner", choices=("auto", "vitest", "jest"), default="auto",
                   help="test runner (default: the one package.json uses)")
    g.add_argument("--install", choices=("auto", "always", "never"), default="auto",
                   help="install dependencies from the lockfile, as CI does (auto: when node_modules is missing)")
    g.add_argument("--install-cmd", default=None, help="install command to run instead of the lockfile's")
    g.add_argument("--no-script-args", action="store_true",
                   help="do not take the runner flags of package.json's test script (default: take them)")
    g.add_argument("--det-cache", action="store_true",
                   help="Node: pass --det-cache=<cache dir> to detjs when it supports it (no-op until then). Python "
                        "always uses the cache")
    g.add_argument("--max-minimise", type=int, default=8,
                   help="Node: earlier tests of the same file tried as the cause of a flaky test (default 8)")
    a = p.parse_args(argv)
    lang = resolve_lang(a)
    if lang == "node":
        return cmd_run_node(a, extra)
    a.python = a.python or sys.executable
    return cmd_run(a, extra)


def resolve_lang(a: argparse.Namespace) -> str:
    if a.lang != "auto":
        return a.lang
    if a.python:
        return "python"
    langs = detect_languages(Path(a.project).resolve())
    if len(langs) == 1:
        return langs[0]
    if not langs:
        return "python"
    raise SystemExit(f"fenvix-run: {a.project} has Python and Node tests; run one job per language with "
                     f"--lang python and --lang node")


if __name__ == "__main__":
    sys.exit(main())
