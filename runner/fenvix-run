#!/usr/bin/env python3
"""fenvix-run: run a project's pytest suite inside the fenvix engine on a `runs-on: fenvix` machine.

What it does, in order:

1. ``pytest --det --det-cache=<persistent dir>`` in the project directory. The cache directory lives on the machine
   (``$FENVIX_CACHE_ROOT/<project key>``), so it survives between jobs: a test whose inputs did not change since a
   previous job is not run again, its result is reused *with a receipt* (what was checked).
2. Every test that failed is run once more, alone, without the cache. A test that passes alone but failed in the
   suite is reported as **flaky (order-dependent)** with its replay command; a test that fails again is a failure.
3. A summary is written to ``$GITHUB_STEP_SUMMARY`` (Markdown) and to ``<out>/summary.json``: tests run, tests
   skipped with proof, test time saved, failures, flaky tests with their replay command, and where the receipts are.

Exit status: pytest's (0 when every test passed or was reused as passed), so a failing suite fails the job.
Standard library only: the wrapper runs with any Python 3.9+; pytest runs with ``--python``.

    fenvix-run --project . --python .venv/bin/python [--key owner/repo] [--out DIR] [-- extra pytest args]
    fenvix-run verify --project . --python PY --summary DIR/summary.json [--out DIR]

Node (vitest, jest, node:test, mocha) runs inside detjs, the engine's Node shell (runner/bootstrap.sh installs it on
the job PATH), with the cache in ``$FENVIX_CACHE_ROOT/<project key>-node<major>``:

    fenvix-run node --project DIR [--runner vitest|jest|node-test|mocha] [--key owner/repo] [--out DIR] [-- runner args]
    fenvix-run verify --summary DIR/summary.json [--out DIR]     (a Node summary: fresh run + `detjs verify`)

Without --runner the runner is read from package.json (devDependencies vitest / jest / mocha, or a scripts.test that
runs ``node --test``); none or more than one: exit 2. Exit status: detjs's (0 every test passed and proven; 1 a
failure or a NOT PROVEN test; 2 usage or internal error), never lowered by the re-run of failures. ``verify`` exits
with ``detjs verify``'s code: 0 identical, 1 a wrong reuse, a divergence or NOT PROVEN, 3 only the inputs differ.
The summary has the Python path's field names plus ``language``, ``test_runner``, ``engine``; ``runner_args``
replaces ``pytest_args``.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import xml.etree.ElementTree as ET
from pathlib import Path

DEFAULT_ROOT = os.environ.get("FENVIX_CACHE_ROOT") or os.path.join(os.path.expanduser("~"), ".fenvix", "cache")


def log(msg: str) -> None:
    print(f"[fenvix] {msg}", flush=True)


def project_key(project: Path, given: str | None) -> str:
    """Directory name of the project's cache: the given key (e.g. ``owner/repo``), else the ``origin`` remote URL,
    else the directory name. One cache per project and Python version: a cache never mixes interpreters (the engine
    also checks the runtime digest on every reuse; this only keeps unrelated entries apart)."""
    key = given
    if not key:
        try:
            key = subprocess.run(["git", "-C", str(project), "remote", "get-url", "origin"], capture_output=True,
                                 text=True, check=True).stdout.strip()
        except (OSError, subprocess.CalledProcessError):
            key = project.resolve().name
    key = re.sub(r"^(https?://|git@)", "", key).removesuffix(".git").replace(":", "/")
    safe = re.sub(r"[^A-Za-z0-9._-]+", "_", key).strip("_")
    return safe[:80] + "-" + hashlib.sha256(key.encode()).hexdigest()[:8]


def python_tag(py: str) -> str:
    out = subprocess.run([py, "-c", "import sys; print('py%d%d' % sys.version_info[:2])"], capture_output=True,
                         text=True)
    return out.stdout.strip() or "py"


def git_head(project: Path) -> str:
    r = subprocess.run(["git", "-C", str(project), "rev-parse", "HEAD"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


RUNTIME_PROBE = ("import json, sys\n"
                 "try:\n"
                 "    from detpy import runtime_id\n"
                 "    d = runtime_id.describe(sys.argv[1]); det = d.pop('details')\n"
                 "    d.update(dist_list=det['dist_list'], native_list=det['native_list'],\n"
                 "             python_version=det['python_version'], identity_seconds=det['seconds'],\n"
                 "             cpu_detail=det.get('cpu'), extra_paths_list=det.get('extra_paths'))\n"
                 "    try:  # the previous identity (RECORD bytes, listing of the stdlib), for comparison\n"
                 "        import os, platform, sysconfig\n"
                 "        from detpy import _core\n"
                 "        from detpy.proofcache import _dist_infos\n"
                 "        exe = os.path.realpath(sys.executable)\n"
                 "        lib = os.path.join(sysconfig.get_config_var('LIBDIR') or '', sysconfig.get_config_var('LDLIBRARY') or '')\n"
                 "        dl = _dist_infos(sys.argv[1])[0]\n"
                 "        old = {'python': sys.version, 'cache_tag': sys.implementation.cache_tag,\n"
                 "               'executable': _core.file_digest(exe), 'libpython': _core.file_digest(lib) if os.path.isfile(lib) else None,\n"
                 "               'system': platform.system(), 'machine': platform.machine(), 'libc': '-'.join(platform.libc_ver()),\n"
                 "               'stdlib': _core.listing_digest(os.path.dirname(os.__file__)),\n"
                 "               'distributions': _core.digest('\\n'.join(dl).encode()), 'n_distributions': len(dl)}\n"
                 "        d['previous_identity'] = _core.digest(json.dumps(old, sort_keys=True).encode())\n"
                 "        d['previous_dist_list'] = dl\n"
                 "    except Exception as e:\n"
                 "        d['previous_identity'] = f'error: {e}'\n"
                 "except ImportError:\n"
                 "    from detpy.proofcache import runtime_identity, _dist_infos\n"
                 "    dig, info, _ = runtime_identity(sys.argv[1])\n"
                 "    d = {'digest': dig, **info, 'dist_list': _dist_infos(sys.argv[1])[0]}\n"
                 "print(json.dumps(d))\n")
_LIST_PARTS = {"distributions": "dist_list", "native": "native_list", "previous_identity": "previous_dist_list",
               "cpu": "cpu_detail"}


def runtime_components(py: str, project: Path) -> dict:
    """The engine's runtime identity, part by part (interpreter, native libraries with libc, standard library,
    installed distributions, import path; see detpy.runtime_id). A cache entry is reused only under the same digest,
    so when a job reuses nothing on `runtime`, comparing these parts with the previous job's names the cause."""
    env = without_client_env(dict(os.environ))
    r = subprocess.run([py, "-c", RUNTIME_PROBE, str(project)], capture_output=True, text=True, cwd=project, env=env)
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"error": (r.stderr or r.stdout)[-300:]}


def runtime_diff(prev: dict | None, rt: dict) -> list[str]:
    """Names of the runtime parts that changed, with the list entries that differ (e.g. ``-pkg==1.0:...``)."""
    if not prev:
        return []
    lists = set(_LIST_PARTS.values())
    out = sorted(k for k in set(rt) | set(prev) if k not in lists and k != "identity_seconds"
                 and prev.get(k) != rt.get(k))
    for part, lst in _LIST_PARTS.items():
        if part in out:
            b, a = prev.get(lst) or [], rt.get(lst) or []
            if isinstance(b, dict) or isinstance(a, dict):
                b = [f"{k}={v}" for k, v in sorted((b or {}).items())] if isinstance(b, dict) else b
                a = [f"{k}={v}" for k, v in sorted((a or {}).items())] if isinstance(a, dict) else a
            before, after = set(b), set(a)
            out += [f"-{d}" for d in sorted(before - after)] + [f"+{d}" for d in sorted(after - before)]
    return out


def machine_identity() -> dict:
    """Which machine ran the job (to show that two jobs ran on two machines): host name, a digest of
    /etc/machine-id and of the boot id, CPU model."""
    def digest_of(path: str) -> str | None:
        try:
            return hashlib.sha256(Path(path).read_bytes().strip()).hexdigest()[:12]
        except OSError:
            return None
    cpu = None
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                cpu = line.split(":", 1)[1].strip()
                break
    except OSError:
        pass
    return {"hostname": os.uname().nodename, "runner_name": os.environ.get("RUNNER_NAME"),
            "machine_id": digest_of("/etc/machine-id"),
            "boot_id": digest_of("/proc/sys/kernel/random/boot_id"), "cpu": cpu, "cpus": os.cpu_count()}


_CLIENT_ENV = ("FENVIX_CACHE_TOKEN", "FENVIX_CACHE_TOKEN_FD", "FENVIX_CACHE_TOKEN_FILE", "FENVIX_CACHE_LOCAL",
               "FENVIX_CACHE_REPORT")


def without_client_env(env: dict) -> dict:
    """The environment of a pytest run that does not use the shared cache: no token, no client settings."""
    return {k: v for k, v in env.items() if k not in _CLIENT_ENV}


def is_url(v: str | None) -> bool:
    return bool(v) and v.startswith(("http://", "https://"))


def run_pytest(py: str, project: Path, args: list[str], env: dict, token: str | None = None) -> tuple[int, float]:
    """Run pytest. A shared-cache token goes on an inherited pipe (FENVIX_CACHE_TOKEN_FD), never in the environment
    or a file: the engine reads it and closes the pipe before any test runs."""
    cmd = [py, "-m", "pytest", *args]
    log("$ " + " ".join(shlex.quote(c) for c in cmd))
    fds: tuple = ()
    if token:
        r, w = os.pipe()
        os.write(w, token.encode())
        os.close(w)
        env = dict(env, FENVIX_CACHE_TOKEN_FD=str(r))
        fds = (r,)
    t0 = time.monotonic()
    try:
        code = subprocess.run(cmd, cwd=project, env=env, pass_fds=fds).returncode
    finally:
        for fd in fds:
            os.close(fd)
    return code, time.monotonic() - t0


def take_token(env: dict) -> str | None:
    """The shared-cache token, taken out of ``env``: FENVIX_CACHE_TOKEN, or the hand-off file FENVIX_CACHE_TOKEN_FILE
    (deleted once read, so no test can find it on disk)."""
    token = env.pop("FENVIX_CACHE_TOKEN", None)
    path = env.pop("FENVIX_CACHE_TOKEN_FILE", None)
    if not token and path:
        try:
            with open(path) as fh:
                token = fh.read()
            os.unlink(path)
        except OSError as e:
            log(f"warning: cannot read FENVIX_CACHE_TOKEN_FILE: {e}")
    return token.strip() if token else None


def junit_times(path: Path) -> dict[str, float]:
    """Per-test durations from a JUnit XML file, keyed by a ``file::name`` approximation of the node id (classname
    dots are not file paths, so durations are matched by test name suffix when needed)."""
    out: dict[str, float] = {}
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return out
    for tc in root.iter("testcase"):
        out[f"{tc.get('classname', '')}::{tc.get('name', '')}"] = float(tc.get("time") or 0.0)
    return out


def total_time(times: dict[str, float]) -> float:
    return round(sum(times.values()), 3)


def read_receipts(path: Path) -> list[dict]:
    rows = []
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if line:
                    rows.append(json.loads(line))
    except OSError:
        pass
    return rows


def fmt_s(s: float) -> str:
    if s >= 120:
        return f"{s / 60:.1f} min"
    return f"{s:.1f} s"


# ---------------------------------------------------------------------------------------------------------------------
def cmd_run(a: argparse.Namespace, extra: list[str]) -> int:
    project = Path(a.project).resolve()
    out = Path(a.out or (Path(os.environ.get("RUNNER_TEMP", project)) / "fenvix")).resolve()
    out.mkdir(parents=True, exist_ok=True)
    key = project_key(project, a.key)
    ns = f"{key}-{python_tag(a.python)}"
    env = dict(os.environ)
    env.pop("PYTHONHASHSEED", None)  # the engine fixes it itself (re-exec)
    remote_p = out / "shared-cache.json"
    remote_p.unlink(missing_ok=True)
    if is_url(a.cache):
        # shared cache service: this machine's directory is the local mirror (and the fallback)
        cache = Path(DEFAULT_ROOT) / ns
        cache_arg = f"{a.cache.rstrip('/')}/{ns}"
        env["FENVIX_CACHE_LOCAL"] = str(cache)
        env["FENVIX_CACHE_REPORT"] = str(remote_p)
        token = take_token(env)
        if not token:
            log("warning: no FENVIX_CACHE_TOKEN or FENVIX_CACHE_TOKEN_FILE: the service will refuse the requests "
                "(local mirror only)")
    else:
        token = None
        cache = Path(a.cache) if a.cache else Path(DEFAULT_ROOT) / ns
        cache_arg = str(cache)
    cache.mkdir(parents=True, exist_ok=True)
    had_cache = any(cache.iterdir())
    receipts = out / "receipts.jsonl"
    outcomes_p, junit_p = out / "outcomes.json", out / "junit.xml"
    for p in (receipts, outcomes_p, junit_p):
        p.unlink(missing_ok=True)

    base = ["--det", "--det-urandom", "-p", "no:cacheprovider", "-q", "-rN", "--tb=short"]
    args = base + [f"--det-cache={cache_arg}", f"--det-cache-receipts={receipts}", f"--det-outcomes={outcomes_p}",
                   f"--junitxml={junit_p}", *extra]
    log(f"project {project} @ {git_head(project)[:12]}; cache {cache_arg} (local {cache}: "
        f"{'warm' if had_cache else 'cold'})")
    code, wall = run_pytest(a.python, project, args, env, token)
    try:
        shared = json.loads(remote_p.read_text())
    except (OSError, ValueError):
        shared = None

    try:
        res = json.loads(outcomes_p.read_text())
    except (OSError, ValueError):
        res = {}
    outcomes: dict[str, str] = res.get("outcomes", {})
    cache_s: dict = res.get("cache") or {}
    rec = read_receipts(receipts)
    reused = [r for r in rec if r.get("reused")]
    saved = round(sum(float(r.get("duration") or 0.0) for r in reused), 3)
    times = junit_times(junit_p)
    ran_time = total_time(times)  # reused tests report ~0 s
    failed = sorted(n for n, o in outcomes.items() if o in ("failed", "error"))

    # Failures: once more, alone, without the cache. Passes alone -> flaky (order-dependent), with its replay.
    flaky, real = [], list(failed)
    if failed and not a.no_rerun:
        again_p = out / "outcomes-rerun.json"
        again_p.unlink(missing_ok=True)
        epoch = cache_s.get("epoch_ns")
        ep = []
        if epoch:
            t = dt.datetime.fromtimestamp(epoch // 1_000_000_000, tz=dt.timezone.utc)
            ep = [f"--det-epoch={t.strftime('%Y-%m-%dT%H:%M:%S')}"]
        rr_args = ["--det", "--det-urandom", "-p", "no:cacheprovider", "-q", "--tb=no", *ep,
                   f"--det-outcomes={again_p}", *[x for x in extra if not x.startswith("--det-cache")]]
        real, flaky = [], []
        for nid in failed[: a.max_reruns]:
            run_pytest(a.python, project, rr_args + [nid], without_client_env(env))
            try:
                o2 = json.loads(again_p.read_text()).get("outcomes", {}).get(nid)
            except (OSError, ValueError):
                o2 = None
            (flaky if o2 == "passed" else real).append(nid)
        real += failed[a.max_reruns:]

    rt = runtime_components(a.python, project)
    rt_file = cache.parent / f"{cache.name}.fenvix-runtime.json"
    try:
        prev_rt = json.loads(rt_file.read_text())
    except (OSError, ValueError):
        prev_rt = None
    rt_changed = runtime_diff(prev_rt, rt)
    try:
        rt_file.write_text(json.dumps(rt, indent=1))
    except OSError:
        pass

    rel_cache = f"--det-cache={cache_arg}"
    replay_full = " ".join(shlex.quote(x) for x in ["python", "-m", "pytest", *base, *extra])
    summary = {
        "project": str(project), "commit": git_head(project), "cache_dir": str(cache), "cache_was_warm": had_cache,
        "exit": code, "wall_seconds": round(wall, 3),
        "tests": len(outcomes),
        "reused_with_proof": len(reused),
        "ran": len(outcomes) - len(reused),
        "test_seconds_saved": saved,
        "test_seconds_run": ran_time,
        "share_of_test_time_saved": round(saved / (saved + ran_time), 4) if (saved + ran_time) else 0.0,
        "failed": real, "flaky": [{"nodeid": n, "replay": f"{replay_full}  # whole suite, same order: fails again",
                                   "minimise": f"detpy repro {shlex.quote(n)} --seed fixed"} for n in flaky],
        "outcome_counts": {k: sum(1 for o in outcomes.values() if o == k) for k in sorted(set(outcomes.values()))},
        "not_cached": cache_s.get("not_cached", {}),
        "not_reused_reasons": cache_s.get("miss_reasons", {}),
        "cache_check_seconds": cache_s.get("check_seconds"), "cache_record_seconds": cache_s.get("record_seconds"),
        "epoch_ns": cache_s.get("epoch_ns"),
        "receipts": str(receipts), "outcomes_file": str(outcomes_p),
        "outcomes": outcomes,
        "reused_outcomes": {r["nodeid"]: r.get("outcome") for r in reused},
        "pytest_args": args, "cache_arg": rel_cache,
        "runtime": rt, "runtime_changed_since_previous_job": rt_changed,
        "machine": machine_identity(), "shared_cache": shared,
        "reused_from_shared_cache": (shared or {}).get("pull_proven", 0),
    }
    (out / "summary.json").write_text(json.dumps(summary, indent=1))
    write_step_summary(summary, a.title)
    log(f"tests {summary['tests']}, reused with proof {summary['reused_with_proof']}, ran {summary['ran']}, "
        f"saved {fmt_s(saved)} of test time ({summary['share_of_test_time_saved']:.1%}), failed {len(real)}, "
        f"flaky {len(flaky)}")
    if shared:
        log(f"shared cache {shared.get('service')} [{shared.get('namespace')}]: "
            f"{shared.get('pull_proven', 0)} results proven from entries recorded on other machines, "
            f"{shared.get('push_entry_docs_new', 0)} entries pushed; error: {shared.get('error')}")
    if rt_changed:
        log("runtime changed since the previous job on this cache: " + ", ".join(rt_changed))
    log(f"runtime {rt.get('digest')}: " + json.dumps({k: v for k, v in rt.items()
                                                       if k not in ("dist_list", "native_list", "digest")}))
    log(f"machine: {json.dumps(summary['machine'])}")
    return code


def run_link() -> str | None:
    s, r, i = (os.environ.get(k) for k in ("GITHUB_SERVER_URL", "GITHUB_REPOSITORY", "GITHUB_RUN_ID"))
    return f"{s}/{r}/actions/runs/{i}#artifacts" if s and r and i else None


def write_step_summary(s: dict, title: str | None, runner_label: str = "pytest") -> None:
    L = [f"## {title or 'fenvix'}: tests with proof", ""]
    L.append(f"Commit `{s['commit'][:12]}` · cache {'warm' if s['cache_was_warm'] else 'cold (first job on this machine)'}"
             f" · machine `{os.uname().nodename}`")
    sh = s.get("shared_cache")
    if sh:
        L += ["", f"Shared cache `{sh.get('namespace')}`: **{sh.get('pull_proven', 0)}** results proven from entries "
                  f"recorded on other machines; {sh.get('push_entry_docs_new', 0)} new entries pushed"
                  + (f"; service error (local mirror used): {sh['error']}" if sh.get("error") else "") + "."]
    L += ["", "| | |", "|---|---|",
          f"| Tests | **{s['tests']}** |",
          f"| Run | {s['ran']} |",
          f"| Skipped with proof (result reused, receipt kept) | **{s['reused_with_proof']}** |",
          f"| Test time saved | **{fmt_s(s['test_seconds_saved'])}** ({s['share_of_test_time_saved']:.1%} of test time) |",
          f"| Test time spent | {fmt_s(s['test_seconds_run']) if s['test_seconds_run'] is not None else 'unknown'} |",
          f"| Failures | {len(s['failed'])} |",
          f"| Flaky (fail in the suite, pass alone) | {len(s['flaky'])} |",
          f"| Job wall time ({runner_label}) | {fmt_s(s['wall_seconds'])} |", ""]
    oc = ", ".join(f"{k} {v}" for k, v in s["outcome_counts"].items())
    L.append(f"Outcomes: {oc or 'none'}.")
    link = run_link()
    L.append("")
    L.append("Receipts: one line per test (what was checked before a result was reused, or why a test ran): "
             + (f"artifact `fenvix-receipts` on [this run]({link})." if link else f"`{s['receipts']}`."))
    if s["failed"]:
        L += ["", "### Failures", ""] + [f"- `{n}`" for n in s["failed"][:50]]
    if s["flaky"]:
        L += ["", "### Flaky tests (reproducible: the run is deterministic)", ""]
        for f in s["flaky"][:20]:
            L += [f"- `{f['nodeid']}`", f"  - replay: `{f['replay']}`", f"  - minimise: `{f['minimise']}`"]
    if s.get("runtime_changed_since_previous_job"):
        L += ["", "Runtime changed since the previous job on this cache (every entry recorded under the old runtime is "
              "out of reach): " + ", ".join(f"`{k}`" for k in s["runtime_changed_since_previous_job"]) + "."]
    why = {**s["not_reused_reasons"]}
    if why or s["not_cached"]:
        L += ["", "<details><summary>Why the other tests ran</summary>", ""]
        if why:
            L.append("Not reused (an input changed or no entry yet): "
                     + ", ".join(f"{k} {v}" for k, v in sorted(why.items(), key=lambda kv: -kv[1])) + ".")
        if s["not_cached"]:
            L.append("")
            L.append("Not cacheable (the test touched something the engine cannot prove): "
                     + ", ".join(f"{k} {v}" for k, v in sorted(s["not_cached"].items(), key=lambda kv: -kv[1])) + ".")
        L += ["", "</details>"]
    text = "\n".join(L) + "\n"
    target = os.environ.get("GITHUB_STEP_SUMMARY")
    if target:
        with open(target, "a") as fh:
            fh.write(text)
    else:
        print(text)


# ---------------------------------------------------------------------------------------------------------------------
def cmd_verify(a: argparse.Namespace, extra: list[str]) -> int:
    """Run the full suite again *without* the cache, at the same epoch and with the same arguments, and check that
    every reused outcome is the outcome a real run gives. A mismatch is run a second time: if the second fresh run
    agrees with the first, the reuse was wrong; otherwise the test is flaky."""
    project = Path(a.project).resolve()
    s = json.loads(Path(a.summary).read_text())
    out = Path(a.out or Path(a.summary).parent).resolve()
    reused: dict[str, str] = s["reused_outcomes"]
    ep = []
    if s.get("epoch_ns"):
        t = dt.datetime.fromtimestamp(s["epoch_ns"] // 1_000_000_000, tz=dt.timezone.utc)
        ep = [f"--det-epoch={t.strftime('%Y-%m-%dT%H:%M:%S')}"]
    keep = [x for x in s["pytest_args"] if not x.startswith(("--det-cache", "--det-outcomes", "--junitxml"))]
    env = without_client_env(dict(os.environ))
    env.pop("PYTHONHASHSEED", None)

    def fresh(tag: str, ids: list[str] | None = None) -> dict:
        p = out / f"outcomes-verify-{tag}.json"
        p.unlink(missing_ok=True)
        run_pytest(a.python, project, keep + ep + [f"--det-outcomes={p}"] + (ids or []), env)
        try:
            return json.loads(p.read_text()).get("outcomes", {})
        except (OSError, ValueError):
            return {}

    f1 = fresh("1")
    checked = [n for n in reused if n in f1]
    mism = [n for n in checked if f1[n] != reused[n]]
    wrong, flaky = [], []
    if mism:
        f2 = fresh("2")
        for n in mism:
            (wrong if f2.get(n) == f1[n] else flaky).append(n)
    v = {"reused": len(reused), "checked": len(checked), "same": len(checked) - len(mism), "wrong": wrong,
         "flaky": flaky, "missing_in_fresh_run": sorted(set(reused) - set(f1)),
         "all_outcomes_same": all(f1.get(n) == o for n, o in s["outcomes"].items() if n in f1)}
    (out / "verify.json").write_text(json.dumps(v, indent=1))
    text = (f"## fenvix: every skip checked\n\nThe whole suite was run again without the cache. Of "
            f"**{v['reused']}** results reused with proof, **{v['checked']}** were checked, **{v['same']}** matched; "
            f"**wrong: {len(wrong)}**, flaky: {len(flaky)}, not in the fresh run: {len(v['missing_in_fresh_run'])}.\n")
    if wrong:
        text += "\nWrong reuses:\n" + "".join(f"- `{n}`: reused {reused[n]}, real {f1[n]}\n" for n in wrong)
    target = os.environ.get("GITHUB_STEP_SUMMARY")
    if target:
        with open(target, "a") as fh:
            fh.write(text)
    print(text)
    return 1 if wrong or v["checked"] < v["reused"] else 0


# ---------------------------------------------------------------------------------------------------------------------
# Node: `fenvix-run node` runs vitest, jest, node:test or mocha inside detjs (the engine's Node shell) with the cache.
NODE_RUNNERS = ("vitest", "jest", "node-test", "mocha")
TEST_RUNNER_NAME = {"vitest": "vitest", "jest": "jest", "node-test": "node:test", "mocha": "mocha"}


def detect_node_runner(project: Path) -> tuple[str | None, str]:
    """The test runner named by the project's package.json: devDependencies vitest / jest / mocha, or a
    ``scripts.test`` that runs ``node --test``. Returns (runner, "") for exactly one, else (None, why)."""
    pj = project / "package.json"
    try:
        data = json.loads(pj.read_text())
    except OSError:
        return None, f"no package.json in {project}"
    except ValueError as e:
        return None, f"{pj} is not valid JSON ({e})"
    if not isinstance(data, dict):
        return None, f"{pj} is not a JSON object"
    dev = data.get("devDependencies") or {}
    found = [r for r in ("vitest", "jest", "mocha") if isinstance(dev, dict) and r in dev]
    script = ((data.get("scripts") or {}).get("test") or "") if isinstance(data.get("scripts"), dict) else ""
    if re.search(r"(^|[\s;&|(])node\s+(\S+\s+)*--test(\s|=|$)", script):
        found.append("node-test")
    if len(found) == 1:
        return found[0], ""
    if not found:
        return None, (f"no test runner found in {pj}: none of vitest, jest, mocha in devDependencies and no "
                      f"`node --test` in scripts.test (scripts.test: {script!r}); pass --runner")
    return None, f"more than one test runner found in {pj}: {', '.join(found)}; pass --runner"


def find_detjs(given: str | None) -> list[str] | None:
    """The detjs command: --detjs, $FENVIX_DETJS, `detjs` on PATH, else $FENVIX_HOME/bin/detjs."""
    for c in (given, os.environ.get("FENVIX_DETJS")):
        if c:
            cmd = shlex.split(c)
            return cmd if cmd and shutil.which(cmd[0]) else None
    w = shutil.which("detjs")
    if w:
        return [w]
    home = os.environ.get("FENVIX_HOME")
    if home and os.access(os.path.join(home, "bin", "detjs"), os.X_OK):
        return [os.path.join(home, "bin", "detjs")]
    return None


def node_major() -> str:
    try:
        v = subprocess.run(["node", "--version"], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return "node"
    m = re.match(r"v(\d+)", v)
    return f"node{m.group(1)}" if m else "node"


def detjs_version(detjs: list[str]) -> str | None:
    try:
        r = subprocess.run([*detjs, "--version"], capture_output=True, text=True)
    except OSError:
        return None
    m = re.search(r"(\d+\.\d+\.\d+\S*)", r.stdout)
    return m.group(1) if r.returncode == 0 and m else None


def run_detjs(detjs: list[str], runner: str, args: list[str], project: Path, env: dict) -> tuple[int, float]:
    cmd = [*detjs, runner, *args]
    log("$ " + " ".join(shlex.quote(c) for c in cmd))
    t0 = time.monotonic()
    try:
        code = subprocess.run(cmd, cwd=project, env=env).returncode
    except OSError as e:
        log(f"error: cannot start detjs: {e}")
        code = 2
    return code, time.monotonic() - t0


def trace_header(path: Path) -> dict:
    try:
        with open(path) as fh:
            first = json.loads(fh.readline())
        return first.get("meta", {}) if first.get("type") == "header" else {}
    except (OSError, ValueError):
        return {}


def epoch_iso(epoch_ns: int | None) -> str | None:
    if not epoch_ns:
        return None
    t = dt.datetime.fromtimestamp(int(epoch_ns) // 1_000_000_000, tz=dt.timezone.utc)
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


def _regex_escape(s: str) -> str:
    return re.sub(r"([.*+?^${}()|\[\]\\/])", r"\\\1", s)


def split_nodeid(nodeid: str) -> tuple[str, list[str]]:
    """``file[@@project]::describe::test`` -> (file, [describe, test])."""
    head, _, rest = nodeid.partition("::")
    return head.split("@@", 1)[0], (rest.split("::") if rest else [])


def reason_key(text: str) -> str:
    """A count key like the Python path's (``new``, ``code``, ``outcome``) from a detjs reason text: lower case, the
    parenthetical dropped, words joined by ``-``, at most 40 characters cut at a word (the App accepts
    ``[A-Za-z0-9_.:-]{1,40}``). The text itself is kept in the summary's ``reason_texts``."""
    words = re.sub(r"[^a-z0-9_.:]+", " ", text.split("(", 1)[0].lower()).split()
    out = ""
    for w in words:
        nxt = f"{out}-{w}" if out else w
        if len(nxt) > 40:
            break
        out = nxt
    return out or (words[0][:40] if words else "other")


def reason_counts(counts: dict, texts: dict) -> dict:
    out: dict[str, int] = {}
    for k, v in (counts or {}).items():
        key = reason_key(str(k))
        texts[key] = str(k) if key not in texts or texts[key] == str(k) else f"{texts[key]} | {k}"
        out[key] = out.get(key, 0) + int(v)
    return out


def outcome_id(receipt_id: str, outcomes: dict) -> str | None:
    """The --det-outcomes id of a receipt's test: the same id, or (a shared-process unit such as mocha's,
    ``file@@process::describe::test``; a Vitest project, ``file@@project::test``) the id without the unit."""
    if receipt_id in outcomes:
        return receipt_id
    head, sep, rest = receipt_id.partition("::")
    plain = head.split("@@", 1)[0] + sep + rest
    return plain if plain in outcomes else None


def single_test_args(runner: str, nodeid: str) -> list[str]:
    """The runner's own command line for one test (the flaky re-run): vitest/jest ``<file> -t "<name>"``, node:test
    ``--test-name-pattern "<name>" <file>``, mocha ``<file> --grep "<name>"``. The name is the test's full title
    (describe blocks and test joined by spaces, as vitest, jest and mocha match it; node:test matches each level, so
    the test's own name), as an anchored regular expression with its special characters escaped."""
    f, parts = split_nodeid(nodeid)
    full = " ".join(parts)
    if runner == "vitest":
        return ["run", f, "-t", "^" + _regex_escape(full) + "$"]
    if runner == "jest":
        return [f, "-t", "^" + _regex_escape(full) + "$"]
    if runner == "node-test":
        return ["--test-name-pattern", "^" + _regex_escape(parts[-1] if parts else f) + "$", f]
    return [f, "--grep", "^" + _regex_escape(full) + "$"]


def _keep_runner_args(extra: list[str]) -> list[str]:
    """Runner arguments of the whole-suite run that also apply to a single-test re-run: options only (positional
    arguments select files, the re-run selects its own). Vitest's subcommand is set by single_test_args."""
    out, skip_next = [], False
    for x in split_wrapper_owned(extra)[0]:
        if skip_next:
            out.append(x)
            skip_next = False
        elif x.startswith("-"):
            out.append(x)
            if "=" not in x and x in ("--config", "-c", "--project", "--root", "--require", "-r", "--import"):
                skip_next = True
    return out


# detjs options the wrapper sets itself (cache, receipts, summaries, outcomes, trace): a job's own value would point a
# fresh verify run at the cache or move the files the summary is built from, so they are dropped from runner args
# (exact names only: --det-cache-verify, --det-cache-max-age, --det-cache-real-clock tighten the proof and stay)
_WRAPPER_OWNED = ("--det-cache", "--det-cache-receipts", "--det-cache-summary", "--det-outcomes", "--det-trace")


def split_wrapper_owned(extra: list[str]) -> tuple[list[str], list[str]]:
    """(kept, dropped): every wrapper-owned option, as ``--opt=value`` or ``--opt value``, goes to dropped."""
    kept, dropped, i = [], [], 0
    while i < len(extra):
        x = extra[i]
        if x.split("=", 1)[0] in _WRAPPER_OWNED:
            take = 1 if "=" in x or i + 1 >= len(extra) else 2
            dropped += extra[i:i + take]
            i += take
            continue
        kept.append(x)
        i += 1
    return kept, dropped


def _runner_args(runner: str, extra: list[str]) -> list[str]:
    # Vitest without a subcommand starts in watch mode on a terminal: a job runs once.
    if runner == "vitest" and (not extra or extra[0] not in ("run", "related", "bench", "list")):
        return ["run", *extra]
    return list(extra)


def write_node_step_summary(s: dict, title: str | None) -> None:
    write_step_summary(s, title or f"fenvix · {s['test_runner']}", runner_label=f"detjs {s['test_runner']}")


def cmd_node(a: argparse.Namespace, extra: list[str]) -> int:
    project = Path(a.project).resolve()
    runner = a.runner
    if not runner:
        runner, why = detect_node_runner(project)
        if not runner:
            log(f"error: {why}")
            return 2
        log(f"runner {runner} (from {project / 'package.json'})")
    detjs = find_detjs(a.detjs)
    if not detjs:
        given = a.detjs or os.environ.get("FENVIX_DETJS")
        log(f"error: detjs not found: {given!r} (--detjs / $FENVIX_DETJS) is not a command" if given else
            "error: detjs not found: not on PATH, no $FENVIX_DETJS, no $FENVIX_HOME/bin/detjs "
            "(runner/bootstrap.sh install builds and installs it)")
        return 2
    out = Path(a.out or (Path(os.environ.get("RUNNER_TEMP", project)) / "fenvix")).resolve()
    out.mkdir(parents=True, exist_ok=True)
    key = project_key(project, a.key)
    ns = f"{key}-{node_major()}"
    cache = Path(a.cache) if a.cache else Path(DEFAULT_ROOT) / ns
    if is_url(str(cache)):
        log("error: a shared cache URL is not supported by `fenvix-run node` (local cache directory only)")
        return 2
    cache.mkdir(parents=True, exist_ok=True)
    had_cache = any(cache.iterdir())
    receipts, csum_p = out / "receipts.jsonl", out / "cache-summary.json"
    outcomes_p, trace_p = out / "outcomes.json", out / "trace.jsonl"
    for p in (receipts, csum_p, outcomes_p, trace_p):
        p.unlink(missing_ok=True)
    env = without_client_env(dict(os.environ))
    kept, dropped = split_wrapper_owned(extra)
    if dropped:
        log("ignored (the wrapper sets them): " + " ".join(shlex.quote(x) for x in dropped))
    runner_args = _runner_args(runner, kept)
    args = ["--det", f"--det-cache={cache}", f"--det-cache-receipts={receipts}", f"--det-cache-summary={csum_p}",
            f"--det-outcomes={outcomes_p}", f"--det-trace={trace_p}", *runner_args]
    log(f"project {project} @ {git_head(project)[:12]}; runner {runner}; cache {cache} "
        f"({'warm' if had_cache else 'cold'})")
    code, wall = run_detjs(detjs, runner, args, project, env)

    try:
        res = json.loads(outcomes_p.read_text())
    except (OSError, ValueError):
        res = {}
    try:
        cs = json.loads(csum_p.read_text())
    except (OSError, ValueError):
        cs = {}
    meta = trace_header(trace_p)
    status = meta.get("status") or {}
    if not isinstance(res, dict) or not isinstance(res.get("outcomes", {}), dict) or not isinstance(status, dict) \
            or not isinstance(cs, dict):
        log(f"error: unreadable detjs output ({outcomes_p}, {trace_p} or {csum_p}): exit 2")
        return 2
    outcomes: dict[str, str] = res.get("outcomes", {})
    rec = read_receipts(receipts)
    # per-test rows (`file::test`) count the tests; file rows (and a shared-process unit) carry the recorded time
    reused_tests = [r for r in rec if r.get("reused") and r.get("kind") != "file" and "::" in r.get("nodeid", "")]
    reused_units = [r for r in rec if r.get("reused") and (r.get("kind") == "file" or "::" not in r.get("nodeid", ""))]
    saved = round(sum(float(r.get("duration") or 0.0) for r in reused_units), 3)
    ran_files = cs.get("ran_files")
    ran_time = round(sum(float((v or {}).get("duration") or 0.0) for v in ran_files.values()), 3) \
        if isinstance(ran_files, dict) else None
    failed = [n for n in res.get("order", sorted(outcomes)) if outcomes.get(n) in ("failed", "error")]
    for n in sorted(outcomes):
        if outcomes[n] not in ("passed", "skipped", "todo", "failed", "error") and n not in failed:
            failed.append(n)  # an unknown outcome counts as failed (node/src/exit-status.js countStatus)
    if code == 0 and (failed or int(status.get("failed") or 0) or int(status.get("not_proven") or 0)):
        log(f"detjs returned 0 with failed or NOT PROVEN tests (status {status}): exit 1")
        code = 1  # never green on a failure (spec "never lower the red")
    elif code == 0 and (not outcomes or not status):
        missing = [n for n, ok in ((f"test outcome in {outcomes_p}", bool(outcomes)), (f"status in {trace_p}", bool(status)))
                   if not ok]
        log(f"detjs returned 0 but wrote no {' and no '.join(missing)}: nothing proves the run green: exit 1")
        code = 1

    # Failures: once more, alone, without the cache, at the run's epoch. Passes alone -> flaky. The exit code stays.
    epoch_ns = int(meta["epoch_ns"]) if meta.get("epoch_ns") else (int(cs["epoch_ms"]) * 1_000_000 if cs.get("epoch_ms") else None)
    ep = [f"--det-epoch={epoch_iso(epoch_ns)}"] if epoch_ns else []
    flaky, real, reruns = [], list(failed), []
    if failed and not a.no_rerun:
        real = []
        keep = _keep_runner_args(extra)
        for i, nid in enumerate(failed[: a.max_reruns]):
            again_p = out / f"outcomes-rerun-{i}.json"
            again_p.unlink(missing_ok=True)
            one = single_test_args(runner, nid)
            run_detjs(detjs, runner, ["--det", *ep, f"--det-outcomes={again_p}",
                                      f"--det-trace={out / f'trace-rerun-{i}.jsonl'}", *keep, *one], project, env)
            try:
                o2 = json.loads(again_p.read_text()).get("outcomes", {}).get(nid)
            except (OSError, ValueError):
                o2 = None
            cmd = " ".join(shlex.quote(x) for x in ["detjs", runner, "--det", *ep, *keep, *one])
            reruns.append({"nodeid": nid, "command": cmd, "outcome": o2})
            (flaky if o2 == "passed" else real).append((nid, cmd))
        real = [n for n, _ in real] + failed[a.max_reruns:]

    version = detjs_version(detjs)
    rt = {"digest": cs.get("runtime"), "config": cs.get("config"), "engine": "detjs",
          "dist_list": [f"detjs@{version}"] if version else [], "node": meta.get("node"),
          "runner_version": meta.get("runner_version"), "parts": cs.get("runtime_parts"),
          "identity_seconds": cs.get("identity_seconds")}
    rt_file = cache.parent / f"{cache.name}.fenvix-runtime.json"
    try:
        prev_rt = json.loads(rt_file.read_text())
    except (OSError, ValueError):
        prev_rt = None
    rt_changed = []
    if prev_rt and isinstance(prev_rt.get("parts"), dict) and isinstance(rt.get("parts"), dict):
        a_, b_ = prev_rt["parts"], rt["parts"]
        rt_changed = sorted(k for k in set(a_) | set(b_) if a_.get(k) != b_.get(k))
    try:
        rt_file.write_text(json.dumps(rt, indent=1))
    except OSError:
        pass

    tests = len(outcomes)
    reason_texts: dict[str, str] = {}
    reused_outcomes = {}
    for r in reused_tests:
        nid = outcome_id(r["nodeid"], outcomes)
        if nid:
            reused_outcomes[nid] = r.get("outcome")
    share = round(saved / (saved + ran_time), 4) if ran_time is not None and (saved + ran_time) else 0.0
    summary = {
        "language": "node", "test_runner": TEST_RUNNER_NAME[runner], "engine": "detjs", "engine_version": version,
        "project": str(project), "commit": git_head(project), "cache_dir": str(cache), "cache_was_warm": had_cache,
        "exit": code, "wall_seconds": round(wall, 3),
        "tests": tests,
        "reused_with_proof": len(reused_outcomes),
        "ran": tests - len(reused_outcomes),
        "test_seconds_saved": saved,
        "test_seconds_run": ran_time,
        "share_of_test_time_saved": share,
        "failed": real,
        "not_proven": int(status.get("not_proven") or 0) if status else None,
        "status": status or None,
        "flaky": [{"nodeid": n, "replay": f"{c}  # alone, without the cache: passes",
                   "minimise": f"detjs repro {shlex.quote(n)}"} for n, c in flaky],
        "reruns": reruns,
        "outcome_counts": {k: sum(1 for o in outcomes.values() if o == k) for k in sorted(set(outcomes.values()))},
        "not_cached": reason_counts(cs.get("not_cached", {}), reason_texts),
        "not_reused_reasons": reason_counts(cs.get("miss_reasons", {}), reason_texts),
        "reason_texts": reason_texts,
        "cache_check_seconds": cs.get("check_seconds"), "cache_record_seconds": cs.get("record_seconds"),
        "epoch_ns": epoch_ns,
        "receipts": str(receipts), "outcomes_file": str(outcomes_p), "trace_file": str(trace_p),
        "cache_summary_file": str(csum_p),
        "outcomes": outcomes,
        "reused_outcomes": reused_outcomes,
        "reused_files": cs.get("reused_files_list", []) if cs else [],
        "runner_args": runner_args, "detjs_args": args, "cache_arg": f"--det-cache={cache}",
        "runtime": rt, "runtime_changed_since_previous_job": rt_changed,
        "machine": machine_identity(), "shared_cache": None, "reused_from_shared_cache": 0,
    }
    (out / "summary.json").write_text(json.dumps(summary, indent=1))
    write_node_step_summary(summary, a.title)
    log(f"tests {tests}, reused with proof {summary['reused_with_proof']}, ran {summary['ran']}, saved {fmt_s(saved)} "
        f"of test time, failed {len(real)}, flaky {len(flaky)}, not proven {summary['not_proven']}; exit {code}")
    if rt_changed:
        log("runtime changed since the previous job on this cache: " + ", ".join(rt_changed))
    return code


def cmd_verify_node(a: argparse.Namespace, s: dict) -> int:
    """Run the suite again without the cache, at the cache run's epoch, with a trace; then ``detjs verify T1 T2
    --json`` over the cache run's trace and this one. Exit: detjs verify's code (0 no wrong reuse; 1 a wrong reuse,
    a divergence or NOT PROVEN; 3 only the inputs differ; 2 usage or unreadable trace)."""
    project = Path(a.project or s["project"]).resolve()
    out = Path(a.out or Path(a.summary).parent).resolve()
    runner = {v: k for k, v in TEST_RUNNER_NAME.items()}.get(s.get("test_runner"))
    if not runner or not s.get("trace_file"):
        log(f"error: {a.summary} is not a fenvix-run node summary (test_runner {s.get('test_runner')!r})")
        return 2
    detjs = find_detjs(getattr(a, "detjs", None))
    if not detjs:
        log("error: detjs not found (runner/bootstrap.sh install)")
        return 2
    t1 = Path(s["trace_file"])
    t2, o2 = out / "trace-fresh.jsonl", out / "outcomes-fresh.json"
    for p in (t2, o2):
        p.unlink(missing_ok=True)
    ep = [f"--det-epoch={epoch_iso(s['epoch_ns'])}"] if s.get("epoch_ns") else []
    env = without_client_env(dict(os.environ))
    args = split_wrapper_owned(list(s.get("runner_args", [])))[0]
    run_detjs(detjs, runner, ["--det", *ep, f"--det-trace={t2}", f"--det-outcomes={o2}", *args], project, env)
    cmd = [*detjs, "verify", str(t1), str(t2), "--json"]
    log("$ " + " ".join(shlex.quote(c) for c in cmd))
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except OSError as e:
        r = subprocess.CompletedProcess(cmd, 2, "", f"cannot start detjs verify: {e}\n")
    sys.stderr.write(r.stderr)
    try:
        rep = json.loads(r.stdout)
    except ValueError:
        rep = None
    reused: dict[str, str] = s.get("reused_outcomes", {})
    if rep is None:
        v = {"verify_status": None, "exit": r.returncode, "error": (r.stderr or r.stdout)[-500:]}
    else:
        sm = rep.get("summary", {})
        rows = rep.get("tests", [])
        wrong = [t["nodeid"] for t in rows if t.get("nodeid") in reused
                 and len(t.get("outcomes") or []) == 2 and (t["outcomes"][1] is None or t["outcomes"][0] != t["outcomes"][1])]
        v = {"verify_status": rep.get("status"), "exit": r.returncode,
             "tests": sm.get("tests"), "identical": sm.get("identical"), "diverged": sm.get("diverged"),
             "missing": sm.get("missing"), "not_proven": sm.get("not_proven"),
             "input_differs": sm.get("input_differs"), "reused": len(reused),
             "reused_checked": sum(1 for t in rows if t.get("nodeid") in reused),
             "wrong_reuse": len(wrong), "wrong": wrong,
             "not_proven_tests": [t["nodeid"] for t in rows if t.get("status") == "not_proven"],
             "diverged_tests": [{"nodeid": t["nodeid"], "reused": t["nodeid"] in reused,
                                 "outcomes": t.get("outcomes"),
                                 "reason": (t.get("divergence") or {}).get("reason")}
                                for t in rows if t.get("status") == "diverged"],
             "traces": [str(t1), str(t2)]}
    (out / "verify.json").write_text(json.dumps(v, indent=1))
    s.update({"verify_status": v.get("verify_status"), "verify_exit": v["exit"],
              "verify_counts": {k: v.get(k) for k in ("tests", "identical", "not_proven", "diverged", "missing",
                                                       "input_differs", "wrong_reuse")}})
    try:
        Path(a.summary).write_text(json.dumps(s, indent=1))
    except OSError:
        pass
    if rep is None:
        text = f"## fenvix: every skip checked\n\n`detjs verify` failed (exit {r.returncode}): nothing verified.\n"
    else:
        text = (f"## fenvix: every skip checked\n\nThe whole suite was run again without the cache, at the same epoch, "
                f"and `detjs verify` compared the two traces: status **{v['verify_status']}**. Of **{v['tests']}** "
                f"tests, {v['identical']} identical, {v['not_proven']} NOT PROVEN, {v['diverged']} diverged, "
                f"{v['missing']} missing; of **{len(reused)}** results reused with proof, **wrong: {v['wrong_reuse']}**.\n")
        def listed(head: str, items: list[str]) -> str:  # at most 50 per list; verify.json has them all
            more = f"- and {len(items) - 50} more (verify.json)\n" if len(items) > 50 else ""
            return f"\n{head}:\n" + "".join(f"- {x}\n" for x in items[:50]) + more if items else ""
        text += listed("Wrong reuses", [f"`{n}`" for n in v["wrong"]])
        text += listed("NOT PROVEN", [f"`{n}`" for n in v["not_proven_tests"]])
        text += listed("Diverged", [f"`{d['nodeid']}` ({d['reason']}; outcomes {d['outcomes']}"
                                    f"{', reused' if d['reused'] else ''})" for d in v["diverged_tests"]])
        if r.returncode == 3:
            text += ("\nExit 3: the two runs' inputs differ (environment, settings): the traces are not comparable, "
                     "so nothing is proven or refuted by this check.\n")
    target = os.environ.get("GITHUB_STEP_SUMMARY")
    if target:
        with open(target, "a") as fh:
            fh.write(text)
    print(text)
    return r.returncode


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    extra: list[str] = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    if argv[:1] == ["node"]:
        p = argparse.ArgumentParser(prog="fenvix-run node")
        p.add_argument("--project", default=".", help="project directory (default: .)")
        p.add_argument("--runner", choices=NODE_RUNNERS, default=None,
                       help="test runner (default: detected from package.json)")
        p.add_argument("--key", default=None, help="cache key of the project (default: its origin URL)")
        p.add_argument("--out", default=None, help="where summary.json, receipts.jsonl, the trace and outcomes go "
                                                   "(default: $RUNNER_TEMP/fenvix)")
        p.add_argument("--cache", default=None, help=f"cache directory (default: {DEFAULT_ROOT}/<key>-node<major>)")
        p.add_argument("--detjs", default=None, help="detjs command (default: $FENVIX_DETJS, else detjs on PATH, "
                                                     "else $FENVIX_HOME/bin/detjs)")
        p.add_argument("--title", default=None, help="heading of the step summary")
        p.add_argument("--no-rerun", action="store_true", help="do not re-run failures alone")
        p.add_argument("--max-reruns", type=int, default=20, help="failures re-run alone at most (default 20)")
        return cmd_node(p.parse_args(argv[1:]), extra)
    verify = bool(argv) and argv[0] == "verify"
    if verify:
        argv = argv[1:]
    p = argparse.ArgumentParser(prog="fenvix-run" + (" verify" if verify else ""))
    p.add_argument("--project", default=None if verify else ".", help="project directory (default: .; for a Node "
                                                                      "summary, the summary's project)")
    p.add_argument("--python", default=sys.executable, help="interpreter with the project, pytest and detpy installed")
    p.add_argument("--out", default=None, help="where summary.json, receipts.jsonl and outcomes go "
                                               "(default: $RUNNER_TEMP/fenvix)")
    if verify:
        p.add_argument("--summary", required=True, help="summary.json written by the cache run")
        p.add_argument("--detjs", default=None, help="detjs command (Node summaries only)")
        a = p.parse_args(argv)
        s = json.loads(Path(a.summary).read_text())
        if s.get("language") == "node":
            return cmd_verify_node(a, s)
        a.project = a.project or "."
        return cmd_verify(a, extra)
    p.add_argument("--key", default=None, help="cache key of the project (default: its origin URL)")
    p.add_argument("--cache", default=None, help=f"cache directory (default: {DEFAULT_ROOT}/<key>-<python>), or the URL "
                                                 "of a shared cache service (token in FENVIX_CACHE_TOKEN; the "
                                                 "machine's directory is then the local mirror)")
    p.add_argument("--title", default=None, help="heading of the step summary")
    p.add_argument("--no-rerun", action="store_true", help="do not re-run failures alone")
    p.add_argument("--max-reruns", type=int, default=20, help="failures re-run alone at most (default 20)")
    a = p.parse_args(argv)
    return cmd_run(a, extra)


if __name__ == "__main__":
    sys.exit(main())
