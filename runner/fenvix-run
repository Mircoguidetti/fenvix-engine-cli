# Node (Vitest / Jest under detjs)

PY_MARKERS = ("pyproject.toml", "setup.py", "setup.cfg", "pytest.ini", "tox.ini", "conftest.py")
LOCKFILES = (("pnpm-lock.yaml", "pnpm"), ("yarn.lock", "yarn"), ("bun.lock", "bun"), ("bun.lockb", "bun"),
             ("package-lock.json", "npm"), ("npm-shrinkwrap.json", "npm"))
NODE_STATUS = {"passed": "passed", "failed": "failed", "pending": "skipped", "skipped": "skipped",
               "disabled": "skipped", "todo": "todo", "focused": "passed"}


def read_package_json(project: Path) -> dict | None:
    try:
        return json.loads((project / "package.json").read_text())
    except (OSError, ValueError):
        return None


def node_runner_of(pkg: dict | None) -> str | None:
    """vitest or jest: the one the ``test`` script calls, else the one in the dependencies."""
    if not pkg:
        return None
    deps = {**(pkg.get("dependencies") or {}), **(pkg.get("devDependencies") or {})}
    script = (pkg.get("scripts") or {}).get("test") or ""
    for r in ("vitest", "jest"):
        if re.search(rf"\b{r}\b", script):
            return r
    if "vitest" in deps:
        return "vitest"
    if "jest" in deps or any(d in deps for d in ("ts-jest", "babel-jest", "jest-cli")):
        return "jest"
    return None


SCRIPT_DROP = {"--watch", "-w", "--run", "--coverage", "--ui", "--open", "--silent", "--passWithNoTests",
               "--detectOpenHandles", "--forceExit", "--runInBand", "-i"}


def script_args(pkg: dict | None, runner: str) -> list[str]:
    """Runner flags of the project's ``test`` script (``"test": "pnpm lint && vitest run --typecheck"`` ->
    ``["--typecheck"]``): the suite is run as the project's CI runs it. Flags that only concern the terminal or that
    the engine sets itself (watch, coverage, run in band, force exit) are dropped; a script that is not a plain call
    of the runner (env assignments, wrappers) gives nothing."""
    script = ((pkg or {}).get("scripts") or {}).get("test") or ""
    for seg in re.split(r"&&|\|\||;", script):
        try:
            toks = shlex.split(seg)
        except ValueError:
            return []
        while toks and toks[0] in ("npx", "pnpm", "yarn", "bunx", "exec", "dlx", "--no-install"):
            toks = toks[1:]
        if not toks or os.path.basename(toks[0]) != runner:
            continue
        toks = toks[1:]
        if runner == "vitest" and toks[:1] in (["run"], ["watch"]):
            toks = toks[1:]
        return [t for t in toks if t.split("=", 1)[0] not in SCRIPT_DROP and not t.startswith("--coverage")]
    return []


def detect_languages(project: Path) -> list[str]:
    langs = []
    if any((project / m).exists() for m in PY_MARKERS):
        langs.append("python")
    if node_runner_of(read_package_json(project)):
        langs.append("node")
    return langs


def find_lockfile(project: Path) -> tuple[Path | None, str | None]:
    """The lockfile that installs this package: in the project directory, else in a parent up to the repository root
    (workspaces keep one lockfile at the root)."""
    d = project
    while True:
        for name, pm in LOCKFILES:
            if (d / name).is_file():
                return d / name, pm
        if (d / ".git").exists() or d.parent == d:
            return None, None
        d = d.parent


def package_manager(project: Path) -> dict:
    lock, pm = find_lockfile(project)
    root = lock.parent if lock else project
    pkg = read_package_json(root) or read_package_json(project) or {}
    declared = str(pkg.get("packageManager") or "")
    ver = None
    if "@" in declared:
        name, ver = declared.split("@", 1)
        ver = ver.split("+", 1)[0]
        if not pm and name in ("npm", "pnpm", "yarn", "bun"):
            pm = name
    pm = pm or "npm"
    berry = False
    if pm == "yarn":
        berry = (ver or "1").split(".")[0] not in ("0", "1")
        try:
            berry = berry or "__metadata:" in lock.read_text()[:4000]
        except (OSError, AttributeError):
            pass
    return {"pm": pm, "version": ver, "declared": declared or None, "lockfile": lock, "root": root, "berry": berry}


def install_command(info: dict) -> list[str]:
    """The command a CI job would run for this lockfile (frozen: the lockfile is never rewritten)."""
    pm, lock = info["pm"], info["lockfile"]
    if pm == "npm":
        return ["npm", "ci"] if lock else ["npm", "install"]
    if pm == "pnpm":
        return ["pnpm", "install", "--frozen-lockfile"] if lock else ["pnpm", "install"]
    if pm == "yarn":
        if not lock:
            return ["yarn", "install"]
        return ["yarn", "install", "--immutable"] if info["berry"] else ["yarn", "install", "--frozen-lockfile"]
    if pm == "bun":
        return ["bun", "install", "--frozen-lockfile"] if lock else ["bun", "install"]
    raise SystemExit(f"fenvix-run: unknown package manager {pm}")


def pm_exe(info: dict, env: dict) -> list[str]:
    """How to start the package manager: corepack when the project pins one (``packageManager``), else the one on PATH,
    else corepack, else ``npx <pm>@<version>``."""
    pm, path = info["pm"], env.get("PATH")
    if pm == "npm":
        return ["npm"]
    corepack = shutil.which("corepack", path=path)
    if info["declared"] and corepack:
        return [corepack, pm]
    if shutil.which(pm, path=path):
        return [pm]
    if corepack:
        return [corepack, pm]
    return ["npx", "--yes", f"{pm}@{info['version'] or 'latest'}"]


def js_regex(text: str) -> str:
    return re.sub(r"[.*+?^${}()|\[\]\\]", lambda m: "\\" + m.group(0), text)


def names_of(nodeid: str) -> tuple[str, list[str]]:
    """``file::describe::test #2`` -> (file, ["describe", "test"])."""
    parts = nodeid.split("::")
    names = parts[1:]
    if names:
        names[-1] = re.sub(r" #\d+$", "", names[-1])
    return parts[0], names


class NodeCtx:
    """The detjs command line for one project (node binary, detjs entry point, runner)."""

    def __init__(self, a: argparse.Namespace, project: Path):
        self.project = project
        self.node = a.node or os.environ.get("FENVIX_NODE_BIN") or shutil.which("node") or "node"
        det = a.detjs or os.environ.get("FENVIX_DETJS") or shutil.which("detjs")
        if not det:
            raise SystemExit("fenvix-run: detjs not found (set FENVIX_DETJS or --detjs; runner/bootstrap.sh installs "
                             "it in $FENVIX_HOME/detjs)")
        self.detjs = det
        self.cmd = [self.node, det] if det.endswith(".js") else [det]
        self._help: str | None = None

    def env(self, base: dict) -> dict:
        env = dict(base)
        nd = os.path.dirname(self.node)
        if nd:  # the package manager and the runner's children use the same node
            env["PATH"] = nd + os.pathsep + env.get("PATH", "")
        return env

    def help(self) -> str:
        if self._help is None:
            r = subprocess.run([*self.cmd, "--det-help"], capture_output=True, text=True, cwd=self.project)
            self._help = r.stdout + r.stderr
        return self._help

    def supports(self, flag: str) -> bool:
        return re.search(rf"(^|\s){re.escape(flag)}(=|\s|$)", self.help(), re.M) is not None

    def run(self, args: list[str], env: dict) -> tuple[int, float]:
        cmd = [*self.cmd, *args]
        log("$ " + " ".join(shlex.quote(c) for c in cmd))
        t0 = time.monotonic()
        code = subprocess.run(cmd, cwd=self.project, env=self.env(env)).returncode
        return code, time.monotonic() - t0

    def version(self) -> dict:
        info: dict = {}
        try:
            pkg = Path(self.detjs).resolve().parent.parent / "package.json"
            info["detjs"] = json.loads(pkg.read_text()).get("version")
            addons = sorted(pkg.parent.glob("detjs.*.node"))
            if addons:
                info["detjs_core"] = hashlib.sha256(addons[0].read_bytes()).hexdigest()[:16]
            src = pkg.parent / "COMMIT"
            if src.is_file():
                info["detjs_commit"] = src.read_text().strip()[:12]
        except (OSError, ValueError):
            pass
        return info


def node_strip(args: list[str]) -> list[str]:
    """Runner arguments without the per-run outputs (trace, report, cache) of the run they were recorded for."""
    out, skip = [], False
    for x in args:
        if skip:
            skip = False
            continue
        if x.startswith(("--det-trace", "--det-cache", "--outputFile", "--reporter=json")) or x == "--json":
            continue
        out.append(x)
    return out


def node_report(path: Path, project: Path) -> dict[str, tuple[str, float]]:
    """{nodeid: (outcome, seconds)} from a Jest-format JSON report (Vitest's json reporter writes the same format),
    with detjs's ids: ``<file relative to the root>::<describe>::...::<name>``, duplicates ``#2``, ``#3``."""
    try:
        rep = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    out: dict[str, tuple[str, float]] = {}
    for f in rep.get("testResults") or []:
        try:
            rel = Path(f["name"]).resolve().relative_to(project).as_posix()
        except (KeyError, ValueError):
            rel = str(f.get("name"))
        seen: dict[str, int] = {}
        for t in f.get("assertionResults") or []:
            base = "::".join([rel, *(t.get("ancestorTitles") or []), t.get("title") or ""])
            seen[base] = seen.get(base, 0) + 1
            nid = base if seen[base] == 1 else f"{base} #{seen[base]}"
            out[nid] = (NODE_STATUS.get(t.get("status"), t.get("status") or "unknown"),
                        round(float(t.get("duration") or 0.0) / 1000.0, 4))
    return out


def node_runtime(ctx: NodeCtx, info: dict) -> dict:
    v = subprocess.run([ctx.node, "--version"], capture_output=True, text=True).stdout.strip()
    rt = {"node": v, "platform": f"{sys.platform}-{platform.machine()}", **ctx.version(),
          "package_manager": info.get("declared") or info["pm"]}
    lock = info.get("lockfile")
    if lock:
        try:
            rt["lockfile"] = hashlib.sha256(lock.read_bytes()).hexdigest()[:16]
        except OSError:
            pass
    rt["digest"] = hashlib.sha256(json.dumps(rt, sort_keys=True).encode()).hexdigest()[:16]
    return rt


def node_install(ctx: NodeCtx, a: argparse.Namespace, info: dict, env: dict) -> dict:
    root = info["root"]
    if a.install_cmd:
        cmd = ["bash", "-c", a.install_cmd]
        shown = a.install_cmd
    else:
        cmd = install_command(info)
        cmd = [*pm_exe(info, ctx.env(env)), *cmd[1:]]
        shown = " ".join(install_command(info))
    has_modules = (root / "node_modules").is_dir() or (ctx.project / "node_modules").is_dir()
    run = a.install == "always" or (a.install == "auto" and not has_modules)
    res = {"package_manager": info["pm"], "package_manager_declared": info["declared"],
           "lockfile": os.path.relpath(info["lockfile"], ctx.project) if info["lockfile"] else None,
           "command": shown, "directory": str(root), "ran": run, "seconds": 0.0, "exit": None}
    if not run:
        log(f"dependencies: node_modules present, not installed again (--install always to force); CI command: {shown}")
        return res
    log(f"dependencies ({info['pm']}{'@' + info['version'] if info['version'] else ''}): $ "
        + " ".join(shlex.quote(c) for c in cmd) + f"  (in {root})")
    t0 = time.monotonic()
    res["exit"] = subprocess.run(cmd, cwd=root, env=ctx.env(env)).returncode
    res["seconds"] = round(time.monotonic() - t0, 3)
    return res


def cmd_run_node(a: argparse.Namespace, extra: list[str]) -> int:
    project = Path(a.project).resolve()
    out = Path(a.out or (Path(os.environ.get("RUNNER_TEMP", project)) / "fenvix")).resolve()
    out.mkdir(parents=True, exist_ok=True)
    pkg = read_package_json(project)
    runner = a.runner if a.runner != "auto" else node_runner_of(pkg)
    if runner not in ("vitest", "jest"):
        raise SystemExit(f"fenvix-run: no Vitest or Jest in {project / 'package.json'} (pass --runner)")
    ctx = NodeCtx(a, project)
    env = dict(os.environ)
    env.pop("DETJS", None)
    env.setdefault("CI", "true")
    info = package_manager(project)
    install = node_install(ctx, a, info, env)
    if install["exit"] not in (None, 0):
        log(f"dependencies: `{install['command']}` failed with exit {install['exit']}")
        return install["exit"]

    rt = node_runtime(ctx, info)
    major = re.sub(r"^v(\d+).*", r"\1", rt.get("node") or "") or "x"
    key = project_key(project, a.key)
    cache = Path(a.cache) if a.cache else Path(DEFAULT_ROOT) / f"{key}-node{major}"
    cache.mkdir(parents=True, exist_ok=True)
    had_cache = any(p for p in cache.iterdir() if not p.name.startswith("."))
    receipts, trace_p, report_p = out / "receipts.jsonl", out / "trace.jsonl", out / f"{runner}-report.json"
    outcomes_p = out / "outcomes.json"
    for p in (receipts, trace_p, report_p, outcomes_p):
        p.unlink(missing_ok=True)

    # Cache with proof: wired, used only when detjs has it (claude/node-cache-proof). Until then: a no-op.
    cache_args: list[str] = []
    if a.det_cache and ctx.supports("--det-cache"):
        cache_args = [f"--det-cache={cache}"]
        if ctx.supports("--det-cache-receipts"):
            cache_args.append(f"--det-cache-receipts={receipts}")
        cache_status = "on"
    elif a.det_cache:
        cache_status = "requested, but this detjs has no --det-cache yet: no-op, every test ran"
    else:
        cache_status = "off for Node (opt in with --det-cache once detjs has it): every test ran"

    head = ["vitest", "run", "--det"] if runner == "vitest" else ["jest", "--det"]
    report = (["--reporter=default", "--reporter=json", f"--outputFile.json={report_p}"] if runner == "vitest"
              else ["--json", f"--outputFile={report_p}"])
    from_script = [] if a.no_script_args else script_args(pkg, runner)
    if from_script:
        log(f"runner flags from the project's test script: {' '.join(from_script)}")
    extra = [*from_script, *extra]
    args = [*head, f"--det-trace={trace_p}", *cache_args, *report, *extra]
    log(f"project {project} @ {git_head(project)[:12]}; {runner} under detjs; cache {cache} "
        f"({'warm' if had_cache else 'cold'}; {cache_status})")
    code, wall = ctx.run(args, env)

    meta, traced = read_trace(trace_p)
    rep = node_report(report_p, project)
    outcomes = {n: t["outcome"] or "unknown" for n, t in traced.items()}
    for n, (o, _) in rep.items():
        outcomes.setdefault(n, o)
    order = [n for n, _ in sorted(traced.items(), key=lambda kv: kv[1].get("index") or 0)]
    timings = {n: secs for n, (_, secs) in rep.items()}
    rec = read_receipts(receipts) if cache_args else []
    reused = [r for r in rec if r.get("reused")]
    reused_ids = {r["nodeid"] for r in reused}
    saved = round(sum(float(r.get("duration") or 0.0) for r in reused), 3)
    ran_time = round(sum(v for n, v in timings.items() if n not in reused_ids), 3)
    failed = sorted(n for n, o in outcomes.items() if o in ("failed", "error"))
    outcomes_p.write_text(json.dumps({"outcomes": outcomes, "order": order, "exitstatus": code}, indent=1))

    base = [*head, *extra]
    shown = lambda xs: " ".join(shlex.quote(x) for x in ["detjs", *xs])  # noqa: E731
    flaky_rows, real = [], list(failed)
    if failed and not a.no_rerun:
        real = []
        budget = [a.max_reruns]

        def outcome_of(nid: str, sel: list[str], tag: str) -> str | None:
            t = out / f"trace-{tag}.jsonl"
            t.unlink(missing_ok=True)
            ctx.run([*base[: len(head)], f"--det-trace={t}", *sel, *extra], env)
            return (read_trace(t)[1].get(nid) or {}).get("outcome")

        def file_sel(f: str) -> list[str]:
            return [f] if runner == "vitest" else ["--runTestsByPath", f]

        def name_sel(names: list[list[str]], sep: str) -> list[str]:
            alts = [js_regex(sep.join(n)) for n in names]
            return ["-t", "^" + (alts[0] if len(alts) == 1 else "(" + "|".join(alts) + ")") + "$"]

        for i, nid in enumerate(failed):
            if budget[0] <= 0:
                real += failed[i:]
                break
            budget[0] -= 1
            f, names = names_of(nid)
            alone, sep_used = None, " "
            for sep in (" ", " > "):
                alone = outcome_of(nid, file_sel(f) + name_sel([names], sep), f"alone-{i}")
                if alone not in (None, "skipped"):
                    sep_used = sep
                    break
            if alone != "passed":
                real.append(nid)
                if alone in (None, "skipped"):
                    log(f"{nid}: could not be selected alone (outcome {alone}); counted as a failure")
                continue
            # Flaky. Find the shortest replay that fails again, and run it.
            before = [x for x in order[: order.index(nid)] if x.split("::")[0] == f] if nid in order else []
            replay, ok, minimal = None, None, None
            if before and outcome_of(nid, file_sel(f), f"file-{i}") == "failed":
                replay, ok = shown([*head, *file_sel(f), *extra]), True
                for j, cand in enumerate(reversed(before[-a.max_minimise:])):
                    _, cn = names_of(cand)
                    sel = file_sel(f) + name_sel([cn, names], sep_used)
                    if outcome_of(nid, sel, f"pair-{i}-{j}") == "failed":
                        minimal = cand
                        break
            if replay is None:  # the state comes from another file: the whole suite, same order
                ok = outcome_of(nid, [], f"suite-{i}") == "failed"
                replay = shown(base) + "  # whole suite, same order"
            mini = (shown([*head, *file_sel(f), *name_sel([names_of(minimal)[1], names], sep_used), *extra])
                    if minimal else replay)
            flaky_rows.append({"nodeid": nid, "replay": replay, "replay_reproduces": ok,
                               "replay_checked": "run by this job after the suite", "minimise": mini,
                               "explanation": flaky_explanation(nid, before, minimal)})

    summary = new_summary(
        language="node", runner=f"{runner} {meta.get('runner_version') or ''}".strip(), project=project, cache=cache,
        had_cache=had_cache, cache_status=cache_status, code=code, wall=wall, outcomes=outcomes, reused=reused,
        saved=saved, ran_time=ran_time, real=real, flaky=flaky_rows, cache_s=meta.get("cache") or {},
        receipts=receipts, outcomes_p=outcomes_p, trace_p=trace_p,
        fingerprints={n: t["fingerprint"] for n, t in traced.items() if n not in reused_ids},
        timings=timings, args=args, cache_arg=cache_args[0] if cache_args else None, install=install, rt=rt,
        rt_changed=runtime_change(rt, cache), epoch_ns=meta.get("epoch_ns"))
    return finish(summary, out, a.title)


def run_link() -> str | None:
    s, r, i = (os.environ.get(k) for k in ("GITHUB_SERVER_URL", "GITHUB_REPOSITORY", "GITHUB_RUN_ID"))
    return f"{s}/{r}/actions/runs/{i}#artifacts" if s and r and i else None


def write_step_summary(s: dict, title: str | None) -> None:
    L = [f"## {title or 'fenvix'}: tests with proof", ""]
    if s.get("language") and s["language"] != "python":
        L += [f"Language `{s['language']}` · runner `{s['runner']}`", ""]
    L.append(f"Commit `{s['commit'][:12]}` · cache {'warm' if s['cache_was_warm'] else 'cold (first job on this machine)'}"
             f" · machine `{os.uname().nodename}`")
    L += ["", "| | |", "|---|---|",
          f"| Tests | **{s['tests']}** |",
          f"| Run | {s['ran']} |",
          f"| Skipped with proof (result reused, receipt kept) | **{s['reused_with_proof']}** |",
          f"| Test time saved | **{fmt_s(s['test_seconds_saved'])}** ({s['share_of_test_time_saved']:.1%} of test time) |",
          f"| Test time spent | {fmt_s(s['test_seconds_run'])} |",
          f"| Failures | {len(s['failed'])} |",
          f"| Flaky (fail in the suite, pass alone) | {len(s['flaky'])} |",
          f"| Job wall time ({s.get('runner') or 'pytest'}) | {fmt_s(s['wall_seconds'])} |", ""]
    oc = ", ".join(f"{k} {v}" for k, v in s["outcome_counts"].items())
    L.append(f"Outcomes: {oc or 'none'}.")
    if s.get("cache_status", "on") != "on":
        L += ["", f"Cache with proof: {s['cache_status']}."]
    link = run_link()
    L.append("")
    if s.get("cache_status", "on") == "on":
        L.append("Receipts: one line per test (what was checked before a result was reused, or why a test ran): "
                 + (f"artifact `fenvix-receipts` on [this run]({link})." if link else f"`{s['receipts']}`."))
    else:
        L.append("Trace (outcome and fingerprint of every test): "
                 + (f"artifact `fenvix-receipts` on [this run]({link})." if link else f"`{s['trace_file']}`."))
    if s["failed"]:
        L += ["", "### Failures", ""] + [f"- `{n}`" for n in s["failed"][:50]]
    if s["flaky"]:
        L += ["", "### Flaky tests (reproducible: the run is deterministic)", ""]
        for f in s["flaky"][:20]:
            seen = (" (run by this job: fails again)" if f.get("replay_reproduces")
                    else " (did NOT fail again when run by this job)" if f.get("replay_reproduces") is False else "")
            L += [f"- `{f['nodeid']}`", f"  - replay: `{f['replay']}`{seen}", f"  - minimise: `{f['minimise']}`"]
            if f.get("explanation"):
                L.append(f"  - why: {f['explanation']}")
    if s.get("runtime_changed_since_previous_job"):
        L += ["", "Runtime changed since the previous job on this cache (every entry recorded under the old runtime is "
              "out of reach): " + ", ".join(f"`{k}`" for k in s["runtime_changed_since_previous_job"]) + "."]
    why = {**s["not_reused_reasons"]}
    if why or s["not_cached"]:
        L += ["", "<details><summary>Why the other tests ran</summary>", ""]
        if why:
            L.append("Not reused (an input changed or no entry yet): "
                     + ", ".join(f"{k} {v}" for k, v in sorted(why.items(), key=lambda kv: -kv[1])) + ".")
        if s["not_cached"]:
            L.append("")
            L.append("Not cacheable (the test touched something the engine cannot prove): "
                     + ", ".join(f"{k} {v}" for k, v in sorted(s["not_cached"].items(), key=lambda kv: -kv[1])) + ".")
        L += ["", "</details>"]
    text = "\n".join(L) + "\n"
    target = os.environ.get("GITHUB_STEP_SUMMARY")
    if target:
        with open(target, "a") as fh:
            fh.write(text)
    else:
        print(text)


