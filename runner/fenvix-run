#!/usr/bin/env python3
"""fenvix-run: run a project's test suite inside the fenvix engine on a `runs-on: fenvix` machine.

Two languages, one summary format. Python (pytest, engine detpy) and Node (Vitest or Jest, engine detjs). A
repository with both runs one job per language, as its workflow defines (``--lang python`` in the Python job,
``--lang node`` in the Node job). Without ``--lang`` the language is detected; a mixed repository needs ``--lang``.

Python, in order:

1. ``pytest --det --det-cache=<persistent dir>`` in the project directory. The cache directory lives on the machine
   (``$FENVIX_CACHE_ROOT/<project key>``), so it survives between jobs: a test whose inputs did not change since a
   previous job is not run again, its result is reused *with a receipt* (what was checked).
2. Every test that failed is run once more, alone, without the cache. A test that passes alone but failed in the
   suite is reported as **flaky (order-dependent)** with its replay command; a test that fails again is a failure.
3. A summary is written to ``$GITHUB_STEP_SUMMARY`` (Markdown) and to ``<out>/summary.json``: tests run, tests
   skipped with proof, test time saved, failures, flaky tests with their replay command, and where the receipts are.

Node, in order (see ``node_run``):

1. Dependencies installed the way the project's CI does it, from its lockfile (``npm ci``, ``pnpm install
   --frozen-lockfile``, ``yarn install --frozen-lockfile`` / ``--immutable``, ``bun install --frozen-lockfile``), when
   ``node_modules`` is missing (``--install``, ``--install-cmd``).
2. ``detjs vitest run --det`` or ``detjs jest --det`` (the runner the project uses), with a JSON report for timings
   and the detjs trace for outcomes and fingerprints. ``--det-cache`` (opt-in) passes ``--det-cache=<dir>`` to detjs
   once detjs supports it (detected from ``detjs --det-help``); until then it is a no-op, said in the summary.
3. Failures run once more, alone (file + exact name). Passes alone -> flaky (order-dependent); the shortest replay
   that fails again is searched (the test's file, then each earlier test of the file with it) and *run*, so the
   replay in the summary is one that was seen to reproduce the failure.
4. The same ``summary.json`` keys and the same step summary as the Python path.

Exit status: the test runner's (0 when every test passed or was reused as passed), so a failing suite fails the job.
Standard library only: the wrapper runs with any Python 3.9+; pytest runs with ``--python``, detjs with ``--node``.

    fenvix-run --project . --python .venv/bin/python [--key owner/repo] [--out DIR] [-- extra pytest args]
    fenvix-run --project . --lang node [--runner auto|vitest|jest] [--det-cache] [-- extra runner args]
    fenvix-run verify --project . --python PY --summary DIR/summary.json [--out DIR]
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import platform
import re
import shutil
import shlex
import subprocess
import sys
import time
import xml.etree.ElementTree as ET
from pathlib import Path

DEFAULT_ROOT = os.environ.get("FENVIX_CACHE_ROOT") or os.path.join(os.path.expanduser("~"), ".fenvix", "cache")


def log(msg: str) -> None:
    print(f"[fenvix] {msg}", flush=True)


def project_key(project: Path, given: str | None) -> str:
    """Directory name of the project's cache: the given key (e.g. ``owner/repo``), else the ``origin`` remote URL,
    else the directory name. One cache per project and Python version: a cache never mixes interpreters (the engine
    also checks the runtime digest on every reuse; this only keeps unrelated entries apart)."""
    key = given
    if not key:
        try:
            key = subprocess.run(["git", "-C", str(project), "remote", "get-url", "origin"], capture_output=True,
                                 text=True, check=True).stdout.strip()
        except (OSError, subprocess.CalledProcessError):
            key = project.resolve().name
    key = re.sub(r"^(https?://|git@)", "", key).removesuffix(".git").replace(":", "/")
    safe = re.sub(r"[^A-Za-z0-9._-]+", "_", key).strip("_")
    return safe[:80] + "-" + hashlib.sha256(key.encode()).hexdigest()[:8]


def python_tag(py: str) -> str:
    out = subprocess.run([py, "-c", "import sys; print('py%d%d' % sys.version_info[:2])"], capture_output=True,
                         text=True)
    return out.stdout.strip() or "py"


def git_head(project: Path) -> str:
    r = subprocess.run(["git", "-C", str(project), "rev-parse", "HEAD"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


RUNTIME_PROBE = ("import json, sys; from detpy.proofcache import runtime_identity, _dist_infos; "
                 "dig, info, _ = runtime_identity(sys.argv[1]); "
                 "print(json.dumps({'digest': dig, **info, 'dist_list': _dist_infos(sys.argv[1])[0]}))")


def runtime_components(py: str, project: Path) -> dict:
    """The engine's runtime identity, part by part (interpreter, libpython, libc, stdlib listing, installed
    distributions). A cache entry is reused only under the same digest, so when a job reuses nothing on `runtime`,
    comparing these parts with the previous job's names the cause."""
    r = subprocess.run([py, "-c", RUNTIME_PROBE, str(project)], capture_output=True, text=True, cwd=project)
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"error": (r.stderr or r.stdout)[-300:]}


def run_pytest(py: str, project: Path, args: list[str], env: dict) -> tuple[int, float]:
    cmd = [py, "-m", "pytest", *args]
    log("$ " + " ".join(shlex.quote(c) for c in cmd))
    t0 = time.monotonic()
    code = subprocess.run(cmd, cwd=project, env=env).returncode
    return code, time.monotonic() - t0


def junit_times(path: Path) -> dict[str, float]:
    """Per-test durations from a JUnit XML file, keyed by a ``file::name`` approximation of the node id (classname
    dots are not file paths, so durations are matched by test name suffix when needed)."""
    out: dict[str, float] = {}
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return out
    for tc in root.iter("testcase"):
        out[f"{tc.get('classname', '')}::{tc.get('name', '')}"] = float(tc.get("time") or 0.0)
    return out


def total_time(times: dict[str, float]) -> float:
    return round(sum(times.values()), 3)


def read_receipts(path: Path) -> list[dict]:
    rows = []
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if line:
                    rows.append(json.loads(line))
    except OSError:
        pass
    return rows


def fmt_s(s: float) -> str:
    if s >= 120:
        return f"{s / 60:.1f} min"
    return f"{s:.1f} s"


SUMMARY_SCHEMA = "fenvix-summary/2"


def read_trace(path: Path) -> tuple[dict, dict[str, dict]]:
    """Header ``meta`` and per-test records (``outcome``, ``fingerprint``, ``index``) of a detpy or detjs trace (same
    format in both engines)."""
    meta: dict = {}
    tests: dict[str, dict] = {}
    try:
        fh = open(path)
    except OSError:
        return meta, tests
    with fh:
        for line in fh:
            if line.startswith('{"type":"header"'):
                try:
                    meta = json.loads(line).get("meta") or {}
                except ValueError:
                    pass
            elif line.startswith('{"type":"test"'):
                try:
                    t = json.loads(line)
                except ValueError:
                    continue  # truncated last line
                tests[t["nodeid"]] = {"outcome": t.get("outcome"), "fingerprint": t.get("fingerprint"),
                                      "index": t.get("index")}
    return meta, tests


def junit_name(nodeid: str) -> str:
    """The ``classname::name`` key pytest's JUnit XML gives a node id (``a/test_x.py::C::t[1]`` ->
    ``a.test_x.C::t[1]``)."""
    parts = nodeid.split("::")
    mod = parts[0][:-3] if parts[0].endswith(".py") else parts[0]
    return ".".join([mod.replace("/", "."), *parts[1:-1]]) + "::" + parts[-1]


def flaky_explanation(nodeid: str, before: list[str], minimal: str | None) -> str:
    why = (f"`{nodeid}` failed in the suite and passed when run alone, so its result depends on what ran before it "
           f"(state left behind by an earlier test). The engine fixes the order, the clock, the seeds and the "
           f"filesystem order, so the same tests in the same order fail the same way: the replay reproduces it.")
    if minimal:
        why += f" Shortest replay found: `{minimal}` before it."
    elif before:
        why += f" {len(before)} test(s) ran before it in its file."
    return why


# ---------------------------------------------------------------------------------------------------------------------
def cmd_run(a: argparse.Namespace, extra: list[str]) -> int:
    project = Path(a.project).resolve()
    out = Path(a.out or (Path(os.environ.get("RUNNER_TEMP", project)) / "fenvix")).resolve()
    out.mkdir(parents=True, exist_ok=True)
    key = project_key(project, a.key)
    cache = Path(a.cache) if a.cache else Path(DEFAULT_ROOT) / f"{key}-{python_tag(a.python)}"
    cache.mkdir(parents=True, exist_ok=True)
    had_cache = any(cache.iterdir())
    receipts = out / "receipts.jsonl"
    outcomes_p, junit_p, trace_p = out / "outcomes.json", out / "junit.xml", out / "trace.jsonl"
    for p in (receipts, outcomes_p, junit_p, trace_p):
        p.unlink(missing_ok=True)

    env = dict(os.environ)
    env.pop("PYTHONHASHSEED", None)  # the engine fixes it itself (re-exec)
    base = ["--det", "--det-urandom", "-p", "no:cacheprovider", "-q", "-rN", "--tb=short"]
    args = base + [f"--det-cache={cache}", f"--det-cache-receipts={receipts}", f"--det-outcomes={outcomes_p}",
                   f"--det-trace={trace_p}", f"--junitxml={junit_p}", *extra]
    log(f"project {project} @ {git_head(project)[:12]}; cache {cache} ({'warm' if had_cache else 'cold'})")
    code, wall = run_pytest(a.python, project, args, env)

    try:
        res = json.loads(outcomes_p.read_text())
    except (OSError, ValueError):
        res = {}
    outcomes: dict[str, str] = res.get("outcomes", {})
    cache_s: dict = res.get("cache") or {}
    rec = read_receipts(receipts)
    reused = [r for r in rec if r.get("reused")]
    saved = round(sum(float(r.get("duration") or 0.0) for r in reused), 3)
    times = junit_times(junit_p)
    ran_time = total_time(times)  # reused tests report ~0 s
    failed = sorted(n for n, o in outcomes.items() if o in ("failed", "error"))

    # Failures: once more, alone, without the cache. Passes alone -> flaky (order-dependent), with its replay.
    flaky, real = [], list(failed)
    if failed and not a.no_rerun:
        again_p = out / "outcomes-rerun.json"
        again_p.unlink(missing_ok=True)
        epoch = cache_s.get("epoch_ns")
        ep = []
        if epoch:
            t = dt.datetime.fromtimestamp(epoch // 1_000_000_000, tz=dt.timezone.utc)
            ep = [f"--det-epoch={t.strftime('%Y-%m-%dT%H:%M:%S')}"]
        rr_args = ["--det", "--det-urandom", "-p", "no:cacheprovider", "-q", "--tb=no", *ep,
                   f"--det-outcomes={again_p}", f"--det-trace={out / 'trace-rerun.jsonl'}",
                   *[x for x in extra if not x.startswith("--det-cache")]]
        real, flaky = [], []
        for nid in failed[: a.max_reruns]:
            run_pytest(a.python, project, rr_args + [nid], env)
            try:
                o2 = json.loads(again_p.read_text()).get("outcomes", {}).get(nid)
            except (OSError, ValueError):
                o2 = None
            (flaky if o2 == "passed" else real).append(nid)
        real += failed[a.max_reruns:]

    rt = runtime_components(a.python, project)
    rt_changed = runtime_change(rt, cache)

    meta, traced = read_trace(trace_p)
    by_junit = {junit_name(n): n for n in outcomes}
    timings = {by_junit.get(k, k): round(v, 4) for k, v in times.items()}
    reused_ids = {r["nodeid"] for r in reused}
    replay_full = " ".join(shlex.quote(x) for x in ["python", "-m", "pytest", *base, *extra])
    order = res.get("order") or list(outcomes)
    flaky_rows = []
    for n in flaky:
        f = n.split("::")[0]
        before = [x for x in order[: order.index(n)] if x.split("::")[0] == f] if n in order else []
        flaky_rows.append({"nodeid": n, "replay": f"{replay_full}  # whole suite, same order: fails again",
                           "replay_reproduces": None, "replay_checked": "the suite run of this job (deterministic)",
                           "minimise": f"detpy repro {shlex.quote(n)} --seed fixed",
                           "explanation": flaky_explanation(n, before, None)})
    summary = new_summary(
        language="python", runner="pytest", project=project, cache=cache, had_cache=had_cache,
        cache_status="on", code=code, wall=wall, outcomes=outcomes, reused=reused, saved=saved, ran_time=ran_time,
        real=real, flaky=flaky_rows, cache_s=cache_s, receipts=receipts, outcomes_p=outcomes_p, trace_p=trace_p,
        fingerprints={n: t["fingerprint"] for n, t in traced.items() if n not in reused_ids},
        timings=timings, args=args, cache_arg=f"--det-cache={cache}", install=None, rt=rt, rt_changed=rt_changed,
        epoch_ns=cache_s.get("epoch_ns") or meta.get("epoch_ns"))
    summary["pytest_args"] = args  # legacy name (schema 1), kept for readers of the Python summaries
    return finish(summary, out, a.title)


def runtime_change(rt: dict, cache: Path) -> list[str]:
    """Names of the runtime parts that changed since the previous job on this cache (the file next to the cache keeps
    the last job's parts)."""
    rt_file = cache.parent / f"{cache.name}.fenvix-runtime.json"
    try:
        prev_rt = json.loads(rt_file.read_text())
    except (OSError, ValueError):
        prev_rt = None
    rt_changed = sorted(k for k in set(rt) | set(prev_rt or {})
                        if k != "dist_list" and (prev_rt or {}).get(k) != rt.get(k)) if prev_rt else []
    if prev_rt and "distributions" in rt_changed:
        before, after = set(prev_rt.get("dist_list", [])), set(rt.get("dist_list", []))
        rt_changed += [f"-{d}" for d in sorted(before - after)] + [f"+{d}" for d in sorted(after - before)]
    try:
        rt_file.write_text(json.dumps(rt, indent=1))
    except OSError:
        pass
    return rt_changed


def new_summary(*, language, runner, project, cache, had_cache, cache_status, code, wall, outcomes, reused, saved,
                ran_time, real, flaky, cache_s, receipts, outcomes_p, trace_p, fingerprints, timings, args, cache_arg,
                install, rt, rt_changed, epoch_ns) -> dict:
    """summary.json: the same keys for every language (tests/summary-schema in the wrapper tests checks it)."""
    try:
        epoch_ns = int(epoch_ns) if epoch_ns is not None else None
    except (TypeError, ValueError):
        epoch_ns = None
    return {
        "schema": SUMMARY_SCHEMA, "language": language, "runner": runner,
        "project": str(project), "commit": git_head(project), "cache_dir": str(cache), "cache_was_warm": had_cache,
        "cache_status": cache_status,
        "exit": code, "wall_seconds": round(wall, 3),
        "tests": len(outcomes),
        "reused_with_proof": len(reused),
        "ran": len(outcomes) - len(reused),
        "test_seconds_saved": saved,
        "test_seconds_run": ran_time,
        "share_of_test_time_saved": round(saved / (saved + ran_time), 4) if (saved + ran_time) else 0.0,
        "failed": real, "flaky": flaky,
        "outcome_counts": {k: sum(1 for o in outcomes.values() if o == k) for k in sorted(set(outcomes.values()))},
        "not_cached": cache_s.get("not_cached", {}),
        "not_reused_reasons": cache_s.get("miss_reasons", {}),
        "cache_check_seconds": cache_s.get("check_seconds"), "cache_record_seconds": cache_s.get("record_seconds"),
        "epoch_ns": epoch_ns,
        "receipts": str(receipts), "outcomes_file": str(outcomes_p), "trace_file": str(trace_p),
        "outcomes": outcomes,
        "reused_outcomes": {r["nodeid"]: r.get("outcome") for r in reused},
        "fingerprints": fingerprints,
        "timings": timings,
        "runner_args": args, "pytest_args": None, "cache_arg": cache_arg,
        "install": install,
        "runtime": rt, "runtime_changed_since_previous_job": rt_changed,
    }


def finish(summary: dict, out: Path, title: str | None) -> int:
    (out / "summary.json").write_text(json.dumps(summary, indent=1))
    write_step_summary(summary, title)
    log(f"tests {summary['tests']}, reused with proof {summary['reused_with_proof']}, ran {summary['ran']}, "
        f"saved {fmt_s(summary['test_seconds_saved'])} of test time ({summary['share_of_test_time_saved']:.1%}), "
        f"failed {len(summary['failed'])}, flaky {len(summary['flaky'])}")
    for f in summary["flaky"]:
        log(f"flaky {f['nodeid']}: replay `{f['replay']}`")
    if summary["runtime_changed_since_previous_job"]:
        log("runtime changed since the previous job on this cache: "
            + ", ".join(summary["runtime_changed_since_previous_job"]))
    rt = summary["runtime"]
    log(f"runtime {rt.get('digest')}: " + json.dumps({k: v for k, v in rt.items() if k not in ("dist_list", "digest")}))
    return summary["exit"]


